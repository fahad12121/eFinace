<%- contentFor('HeaderCss') %>
<%- include ('../partials/title-meta', {"title":"Companies"}) %>
<link href="/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/libs/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/css/companies-page.css" rel="stylesheet" type="text/css" />

<%- contentFor('body') %>

<div class="companies-page">
  <div class="companies-page-header">
    <div>
      <p class="companies-page-eyebrow">Management</p>
      <h1 class="companies-page-title">Companies</h1>
      <p class="companies-page-desc">Manage and switch between your organizations</p>
    </div>
    <button class="companies-add-btn" id="openModal" type="button">
      <i class="mdi mdi-plus"></i>
      Add Company
    </button>
  </div>

  <div class="companies-stats-row">
    <div class="companies-stat-card">
      <div class="stat-icon">
        <i class="mdi mdi-office-building-outline"></i>
      </div>
      <div>
        <span class="stat-value" id="totalCompanies">0</span>
        <span class="stat-label">Total Companies</span>
      </div>
    </div>
  </div>

  <div class="companies-table-card">
    <div class="companies-table-card-header">
      <div>
        <h5>All Companies</h5>
        <p>Browse, search, and open any company workspace</p>
      </div>
    </div>
    <div class="companies-table-body">
      <table id="datatable" class="table companies-table dt-responsive nowrap w-100">
        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </div>
</div>

<div class="modal fade company-modal" id="companyModal" tabindex="-1" aria-labelledby="companyModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <div class="modal-title-icon">
            <i class="mdi mdi-office-building-plus-outline"></i>
          </div>
          <div>
            <h5 class="modal-title" id="companyModalLabel">New Company</h5>
            <p class="modal-subtitle">Add a new organization to your workspace</p>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="modalForm">
          <div class="mb-0">
            <label for="name" class="form-label">Company Name</label>
            <input type="text" class="form-control" id="name" placeholder="Enter company name" required />
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-cancel" id="closeModalButton" data-bs-dismiss="modal">
          Cancel
        </button>
        <button type="submit" class="btn btn-submit" id="submitCompanyBtn" form="modalForm">
          Create Company
        </button>
      </div>
    </div>
  </div>
</div>

<%- contentFor('FooterJs') %>
<script src="/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="/assets/libs/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
<script src="/assets/libs/datatables.net-responsive-bs4/js/responsive.bootstrap4.min.js"></script>

<script>
  function getCompanyInitials(name) {
    if (!name || !name.trim()) return "?";
    return name
      .trim()
      .split(/\s+/)
      .slice(0, 2)
      .map((word) => word.charAt(0).toUpperCase())
      .join("");
  }

  function formatCompanyName(name) {
    if (!name || !name.trim()) {
      return '<span class="company-name-empty">Unnamed company</span>';
    }

    const initials = getCompanyInitials(name);
    return (
      '<div class="company-name-cell">' +
      '<div class="company-avatar">' + initials + '</div>' +
      '<span class="company-name-text">' + $('<div>').text(name.trim()).html() + '</span>' +
      '</div>'
    );
  }

  function formatCompanyAction(companyId) {
    return (
      '<button type="button" class="company-action-btn show-company" data-id="' + companyId + '" title="View company">' +
      '<i class="mdi mdi-eye-outline"></i>' +
      '<span>View</span>' +
      '</button>'
    );
  }

  $(document).ready(function () {
    const dataTable = $("#datatable").DataTable({
      responsive: true,
      language: {
        emptyTable: "No companies found. Create your first company to get started.",
        search: "",
        searchPlaceholder: "Search companies...",
      },
      columnDefs: [
        { orderable: false, targets: 2 },
        { width: "90px", targets: 0 },
        { width: "120px", targets: 2 },
      ],
    });

    function fetchCompaniesAndUpdateTable() {
      $.ajax({
        type: "GET",
        url: "/get/companies/ajax",
        success: function (response) {
          dataTable.clear();

          response.companies.forEach(function (company) {
            dataTable.row.add([
              '<span class="company-id-badge">' + company.id + '</span>',
              formatCompanyName(company.name),
              formatCompanyAction(company.id),
            ]);
          });

          dataTable.draw();
          $("#totalCompanies").text(response.companies.length);
        },
        error: function (error) {
          console.log(error);
        },
      });
    }

    $("#datatable").on("click", ".show-company", function () {
      const companyId = $(this).data("id");
      localStorage.setItem("company_id", companyId);
      showSidebarLinks(companyId);
    });

    const modal = new bootstrap.Modal(document.getElementById("companyModal"), {
      keyboard: false,
    });

    $("#openModal").click(function () {
      modal.show();
    });

    $("#closeModalButton").click(function () {
      modal.hide();
    });

    $("#modalForm").submit(function (event) {
      event.preventDefault();

      const name = $("#name").val();
      const submitBtn = $("#submitCompanyBtn");
      submitBtn.prop("disabled", true).text("Creating...");

      $.ajax({
        type: "POST",
        url: "/company/store",
        data: { name: name },
        success: function () {
          fetchCompaniesAndUpdateTable();
          modal.hide();
          $("#modalForm")[0].reset();
          toastr.success("Company created successfully.", "Success");
        },
        error: function () {
          toastr.error("Error submitting the company. Please try again.", "Error");
        },
        complete: function () {
          submitBtn.prop("disabled", false).text("Create Company");
        },
      });
    });

    const storedCompanyId = localStorage.getItem("company_id");
    if (storedCompanyId) {
      showSidebarLinks(storedCompanyId);
    }

    fetchCompaniesAndUpdateTable();
  });
</script>
