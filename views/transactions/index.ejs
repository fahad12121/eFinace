<%- contentFor('HeaderCss') %>
<%- include ('../partials/title-meta', {"title":"Transactions"}) %>
<link href="/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/libs/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/libs/select2/css/select2.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/css/accounts-page.css" rel="stylesheet" type="text/css" />
<link href="/assets/css/dashboard-page.css" rel="stylesheet" type="text/css" />
<link href="/assets/css/transactions-page.css" rel="stylesheet" type="text/css" />

<%- contentFor('body') %>

<div class="accounts-page transactions-page">
  <div class="accounts-page-header">
    <div>
      <p class="accounts-page-eyebrow">Ledger</p>
      <h1 class="accounts-page-title">Transactions Table</h1>
      <p class="accounts-page-desc">View, filter, and record account transfers</p>
    </div>
    <div class="accounts-header-actions">
      <button class="accounts-header-btn accounts-header-btn-primary" id="openModal">
        <i class="mdi mdi-plus"></i>
        Add Transaction
      </button>
    </div>
  </div>

  <div class="accounts-table-card">
    <div class="accounts-table-card-header">
      <div>
        <h5><i class="mdi mdi-format-list-bulleted"></i> All Transactions</h5>
        <p>Filter by date range or search within the table</p>
      </div>
    </div>

    <div class="transactions-filter-bar">
      <div class="transactions-filter-left">
        <div class="transactions-filter-group">
          <label for="start_date">From</label>
          <input type="date" id="start_date" name="start_date" autocomplete="off" />
        </div>
        <div class="transactions-filter-group">
          <label for="end_date">To</label>
          <input type="date" id="end_date" name="end_date" autocomplete="off" />
        </div>
        <button type="button" class="transactions-search-btn" id="searchTransactionBtn">
          <i class="mdi mdi-magnify"></i>
          Search
        </button>
      </div>
    </div>

    <div class="accounts-table-body transactions-table-wrap">
      <table id="transdatatable" class="table transactions-table dashboard-transactions-table dt-responsive nowrap w-100 mb-0">
          <thead>
            <tr>
              <th class="tx-col-date">Date</th>
              <th class="tx-col-plus">Plus</th>
              <th class="tx-col-plus">Sub Account</th>
              <th class="tx-col-amount">Amount</th>
              <th class="tx-col-minus">Minus</th>
              <th class="tx-col-minus">Sub Account</th>
              <th class="tx-col-narration">Narration</th>
              <th class="tx-col-notes">Notes</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
    </div>
  </div>
</div>

<div class="modal fade accounts-modal transactions-modal" id="AccountTypeModal" tabindex="-1" aria-labelledby="transactionModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <div class="modal-title-icon">
            <i class="mdi mdi-swap-horizontal"></i>
          </div>
          <div>
            <h5 class="modal-title" id="transactionModalLabel">New Transaction</h5>
            <p class="modal-subtitle">Transfer amount between sub-accounts</p>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="modalForm">
          <div class="row">
            <div class="col-md-4">
              <div class="mb-3">
                <label for="sender_sub_account_id" class="form-label">Sender <span class="text-danger">*</span></label>
                <select
                  class="form-control select2 sender_id"
                  style="width: 100%"
                  id="sender_sub_account_id"
                  name="sender_sub_account_id"
                  onchange="updateReceiverOptions(); showParentBalance();"
                >
                  <option value="" selected disabled>--Select--</option>
                  <% sender_accounts.forEach(function(user) { %>
                  <option
                    value="<%= user.subaccount_id %>"
                    data-parent_balance="<%= user.balance %>"
                    data-parent_name="<%= user.parent_name %>"
                  >
                    <%= user.account_username %>
                  </option>
                  <% }) %>
                </select>
              </div>
            </div>
            <div class="col-md-4">
              <div class="mb-3">
                <label for="amount" class="form-label">Amount <span class="text-danger">*</span></label>
                <input type="number" class="form-control" id="amount" name="amount" min="0" oninput="updateBalances()" disabled />
              </div>
            </div>
            <div class="col-md-4">
              <div class="mb-3">
                <label for="receiver_sub_account_id" class="form-label">Receiver <span class="text-danger">*</span></label>
                <select
                  class="form-control select2 receiver_sub_account_id"
                  style="width: 100%"
                  id="receiver_sub_account_id"
                  name="receiver_sub_account_id"
                  onchange="showReceiverParentBalance(); enableAmountInput();"
                >
                  <option value="" selected disabled>--Select--</option>
                  <% receiver_accounts.forEach(function(subAccount) { %>
                  <option
                    value="<%= subAccount.subaccount_id %>"
                    data-parent_balance="<%= subAccount.balance %>"
                    data-parent_name="<%= subAccount.parent_name %>"
                  >
                    <%= subAccount.account_username %>
                  </option>
                  <% }) %>
                </select>
              </div>
            </div>
          </div>

          <div class="tx-modal-balance-row">
            <div class="tx-modal-balance-card sender" id="parent_sender" style="display: none">
              <span class="tx-modal-balance-label">Sender</span>
              <span class="tx-modal-balance-name" id="sender_parent_name"></span>
              <span class="tx-modal-balance-value" id="sender_parent_balance"></span>
            </div>
            <div class="tx-modal-balance-card receiver" id="parent_receiver" style="display: none">
              <span class="tx-modal-balance-label">Receiver</span>
              <span class="tx-modal-balance-name" id="receiver_parent_name"></span>
              <span class="tx-modal-balance-value" id="receiver_parent_balance"></span>
            </div>
          </div>

          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <label for="narration" class="form-label">Narration</label>
                <input type="text" name="narration" class="form-control" id="narration" />
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <label for="notes" class="form-label">Notes</label>
                <input type="text" class="form-control" name="notes" id="notes" />
              </div>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-cancel" id="closeModalButton" data-bs-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-submit" id="transactionSubmitBtn" form="modalForm">Submit</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade accounts-modal transactions-modal" id="editTransactionModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <div class="modal-title-icon">
            <i class="mdi mdi-pencil-outline"></i>
          </div>
          <div>
            <h5 class="modal-title">Edit Notes</h5>
            <p class="modal-subtitle">Update transaction notes</p>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="editmodalForm">
          <div class="mb-0">
            <input type="hidden" name="id" id="trans_id" />
            <label for="trans_notes" class="form-label">Notes</label>
            <input type="text" class="form-control" name="notes" id="trans_notes" />
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-submit" id="editTransactionSubmitBtn" form="editmodalForm">Submit</button>
      </div>
    </div>
  </div>
</div>

<%- contentFor('FooterJs') %>
<script src="/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="/assets/libs/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
<script src="/assets/libs/datatables.net-responsive-bs4/js/responsive.bootstrap4.min.js"></script>
<script src="/assets/libs/select2/js/select2.min.js"></script>

<script>
  let originalSenderBalance = 0;
  let originalReceiverBalance = 0;
  let oldAmount = 0;

  function updateBalances() {
    const amountInput = document.getElementById("amount");
    let amount = parseFloat(amountInput.value);
    if (isNaN(amount) || amount <= 0) amount = 0;

    const senderSelect = document.getElementById("sender_sub_account_id");
    const receiverSelect = document.getElementById("receiver_sub_account_id");
    const senderOption = senderSelect.options[senderSelect.selectedIndex];
    const receiverOption = receiverSelect.options[receiverSelect.selectedIndex];

    const senderBalance = parseFloat(senderOption.getAttribute("data-parent_balance"));
    const receiverBalance = parseFloat(receiverOption.getAttribute("data-parent_balance"));
    const newSenderBalance = senderBalance - oldAmount + amount;
    const newReceiverBalance = receiverBalance + oldAmount - amount;
    oldAmount = amount;

    senderOption.setAttribute("data-parent_balance", newSenderBalance);
    receiverOption.setAttribute("data-parent_balance", newReceiverBalance);

    document.getElementById("sender_parent_balance").innerText = "Current Balance: " + newSenderBalance;
    document.getElementById("receiver_parent_balance").innerText = "Current Balance: " + newReceiverBalance;
  }

  function showParentBalance() {
    const selectElement = document.getElementById("sender_sub_account_id");
    const parentSender = document.getElementById("parent_sender");
    const selectedOption = selectElement.options[selectElement.selectedIndex];
    const parentBalance = selectedOption.getAttribute("data-parent_balance");
    const parentName = selectedOption.getAttribute("data-parent_name");

    parentSender.style.display = "block";
    originalSenderBalance = parseFloat(parentBalance);

    document.getElementById("sender_parent_balance").innerText =
      "Current Balance: " + parseFloat(parentBalance).toFixed(parentBalance % 1 === 0 ? 0 : 2);
    document.getElementById("sender_parent_name").innerText = "Parent Account: " + parentName;

    updateReceiverOptions();
  }

  function showReceiverParentBalance() {
    const selectElement = document.getElementById("receiver_sub_account_id");
    const parentReceiver = document.getElementById("parent_receiver");
    const selectedOption = selectElement.options[selectElement.selectedIndex];
    const parentBalance = selectedOption.getAttribute("data-parent_balance");
    const parentName = selectedOption.getAttribute("data-parent_name");

    parentReceiver.style.display = "block";
    originalReceiverBalance = parseFloat(parentBalance);

    document.getElementById("receiver_parent_balance").innerText = "Current Balance: " + parentBalance;
    document.getElementById("receiver_parent_name").innerText = "Parent Account: " + parentName;
  }

  function updateReceiverOptions() {
    const senderSelect = document.getElementById("sender_sub_account_id");
    const receiverSelect = document.getElementById("receiver_sub_account_id");
    const senderValue = senderSelect.value;

    receiverSelect.querySelectorAll("option").forEach((option) => {
      option.disabled = option.value === senderValue;
    });
  }

  function enableAmountInput() {
    const senderSelect = document.getElementById("sender_sub_account_id");
    const receiverSelect = document.getElementById("receiver_sub_account_id");
    const amountInput = document.getElementById("amount");

    amountInput.disabled = !(senderSelect.value && receiverSelect.value);

    if (!amountInput.value) resetParentBalances();
  }

  function resetParentBalances() {
    document.getElementById("sender_parent_balance").innerText = "Current Balance: " + originalSenderBalance;
    document.getElementById("receiver_parent_balance").innerText = "Current Balance: " + originalReceiverBalance;
  }

  $(document).ready(function () {
    const storedCompanyId = localStorage.getItem("company_id");
    const searchBtn = $("#searchTransactionBtn");

    const dataTable = $("#transdatatable").DataTable({
      pageLength: 200,
      lengthMenu: [[200, 50, 100, -1], [200, 50, 100, "All"]],
      paging: true,
      searching: true,
      autoWidth: false,
      order: [],
      dom: "<'transactions-dt-controls'lf><'transactions-table-scroll't><'transactions-dt-footer'ip>",
      createdRow: function (row) {
        const cols = ["tx-col-date", "tx-col-plus", "tx-col-plus", "tx-col-amount", "tx-col-minus", "tx-col-minus", "tx-col-narration", "tx-col-notes", ""];
        cols.forEach(function (cls, i) {
          if (cls) $("td", row).eq(i).addClass(cls);
        });
      },
    });

    function setSubmitLoading($btn, loading) {
      if (loading) {
        $btn.prop("disabled", true).html('<i class="mdi mdi-loading mdi-spin"></i><span>Submitting...</span>');
      } else {
        $btn.prop("disabled", false).html("Submit");
      }
    }

    function setSearchLoading(loading) {
      if (loading) {
        searchBtn.prop("disabled", true).html('<i class="mdi mdi-loading mdi-spin"></i><span>Loading...</span>');
      } else {
        searchBtn.prop("disabled", false).html('<i class="mdi mdi-magnify"></i> Search');
      }
    }

    function formatAmount(amount) {
      if (amount === null || amount === undefined || amount === "") return "—";
      const num = parseFloat(String(amount).replace(/,/g, ""));
      if (isNaN(num)) return amount;
      return Math.round(num).toLocaleString();
    }

    function formatMeta(text, type) {
      if (!text) return '<span class="acct-notes-empty">—</span>';
      const escaped = String(text).replace(/"/g, "&quot;");
      const cls = type === "narration" ? "tx-narration-badge" : "tx-notes-badge";
      const icon = type === "narration" ? "mdi-text-box-outline" : "mdi-note-text-outline";
      return `<span class="tx-meta-badge ${cls}" title="${escaped}"><i class="mdi ${icon}"></i>${text}</span>`;
    }

    function fetchTransactionTable(startDate, endDate) {
      let url = `/companies/${storedCompanyId}/transactions/ajax`;
      if (startDate !== undefined && endDate !== undefined) {
        url = `/companies/${storedCompanyId}/transactions/ajax?startDate=${startDate}&&endDate=${endDate}`;
      }

      setSearchLoading(true);

      $.ajax({
        type: "GET",
        url: url,
        success: function (response) {
          dataTable.clear();
          response.transactions.forEach(function (transaction) {
            dataTable.row.add([
              `<span class="tx-date-badge"><i class="mdi mdi-calendar-outline"></i>${transaction.transaction_date}</span>`,
              `<span class="tx-user-badge tx-user-plus"><i class="mdi mdi-arrow-up-bold-circle-outline"></i>${transaction.sender_user || "—"}</span>`,
              `<span class="tx-sub-badge tx-sub-plus">${transaction.sender_sub_account || "—"}</span>`,
              `<span class="tx-amount-badge">${formatAmount(transaction.amount)}</span>`,
              `<span class="tx-user-badge tx-user-minus"><i class="mdi mdi-arrow-down-bold-circle-outline"></i>${transaction.receiver_user || "—"}</span>`,
              `<span class="tx-sub-badge tx-sub-minus">${transaction.receiver_sub_account || "—"}</span>`,
              formatMeta(transaction.narration, "narration"),
              formatMeta(transaction.notes, "notes"),
              `<button class="acct-edit-btn edit-btn" data-id="${transaction.id}" title="Edit"><i class="mdi mdi-pencil-outline"></i></button>`,
            ]);
          });

          dataTable.draw();
        },
        error: function (error) {
          console.log(error);
        },
        complete: function () {
          setSearchLoading(false);
        },
      });
    }

    const modal = new bootstrap.Modal(document.getElementById("AccountTypeModal"), { keyboard: false });

    $(document).on("click", ".edit-btn", function () {
      $("#trans_id").val($(this).data("id"));
      $("#editTransactionModal").modal("show");
    });

    $("#openModal").click(function () {
      modal.show();
      $(".select2").select2({
        minimumResultsForSearch: 0,
        dropdownParent: $("#AccountTypeModal"),
      });
    });

    $("#closeModalButton").click(function () {
      modal.hide();
    });

    $(window).click(function (event) {
      if ($(event.target).is(modal._element)) modal.hide();
    });

    $("#modalForm").submit(function (event) {
      event.preventDefault();
      const submitBtn = $("#transactionSubmitBtn");
      setSubmitLoading(submitBtn, true);

      const transaction_date = new Date();
      transaction_date.setDate(transaction_date.getDate() - 1);
      transaction_date.setHours(5, 0, 0, 0);

      const currentTime = new Date();
      if (currentTime.getHours() >= 5) {
        transaction_date.setDate(transaction_date.getDate() + 1);
      }

      const formattedDate = transaction_date.toISOString().split("T")[0];
      const companyId = window.location.pathname.split("/")[2];

      $.ajax({
        type: "POST",
        url: `/companies/${companyId}/transactions`,
        data: {
          sender_sub_account_id: $("#sender_sub_account_id").val(),
          amount: $("#amount").val(),
          receiver_sub_account_id: $("#receiver_sub_account_id").val(),
          narration: $("#narration").val(),
          notes: $("#notes").val(),
          transaction_date: formattedDate,
          company_id: companyId,
        },
        success: function () {
          location.reload();
        },
        error: function (error) {
          toastr.error(error.responseJSON.error, "Error");
        },
        complete: function () {
          setSubmitLoading(submitBtn, false);
        },
      });
    });

    $("#editmodalForm").submit(function (event) {
      event.preventDefault();
      const submitBtn = $("#editTransactionSubmitBtn");
      setSubmitLoading(submitBtn, true);

      const companyId = window.location.pathname.split("/")[2];

      $.ajax({
        type: "POST",
        url: `/companies/${companyId}/transactions/edit`,
        data: {
          id: $("#trans_id").val(),
          notes: $("#trans_notes").val(),
          company_id: companyId,
        },
        success: function (response) {
          toastr.success(response.message, "Success");
          location.reload();
        },
        error: function () {
          alert("Error submitting the transaction. Please try again.");
        },
        complete: function () {
          setSubmitLoading(submitBtn, false);
        },
      });
    });

    function searchTransaction() {
      const startDate = $('input[name="start_date"]').val();
      const endDate = $('input[name="end_date"]').val();
      if (startDate && endDate) {
        fetchTransactionTable(startDate, endDate);
      } else {
        fetchTransactionTable("", "");
      }
    }

    $("#searchTransactionBtn").on("click", searchTransaction);

    if (storedCompanyId) {
      showSidebarLinks(storedCompanyId);
    }

    fetchTransactionTable();
  });
</script>
