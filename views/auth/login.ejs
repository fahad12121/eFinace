<%- contentFor('HeaderCss') %>
<%- include ('../partials/title-meta', { "title": "Login" }) %>
<link href="/assets/css/auth-login.css" rel="stylesheet" type="text/css" />

<%- contentFor('body') %>
<div class="login-page">
  <div class="login-bg">
    <div class="login-orb login-orb-1"></div>
    <div class="login-orb login-orb-2"></div>
    <div class="login-orb login-orb-3"></div>
  </div>

  <div class="login-container">
    <div class="login-card">
      <div class="login-card-top">
        <div class="login-logo-wrap">
          <img src="/assets/images/logo-light.svg" alt="eFinance logo" />
        </div>
        <h1 class="login-title">Welcome back</h1>
        <p class="login-subtitle">Sign in to manage your finances</p>
      </div>

      <div class="login-form-wrap">
        <form class="form-horizontal" action="" method="post" id="loginForm">
          <div id="error"></div>

          <div class="login-field">
            <label for="username">Username</label>
            <div class="login-input-wrap">
              <i class="mdi mdi-account-outline input-icon"></i>
              <input
                type="text"
                class="form-control"
                name="username"
                id="username"
                placeholder="Enter your username"
                autocomplete="username"
              />
            </div>
          </div>

          <div class="login-field">
            <label for="password">Password</label>
            <div class="login-input-wrap login-password-wrap">
              <i class="mdi mdi-lock-outline input-icon"></i>
              <input
                type="password"
                class="form-control"
                placeholder="Enter your password"
                aria-label="Password"
                id="password"
                name="password"
                autocomplete="current-password"
              />
              <button
                class="login-toggle-password"
                type="button"
                id="password-addon"
                aria-label="Toggle password visibility"
              >
                <i class="mdi mdi-eye-outline"></i>
              </button>
            </div>
          </div>

          <div class="login-remember">
            <input
              class="form-check-input"
              type="checkbox"
              id="remember-check"
            />
            <label class="form-check-label" for="remember-check">
              Remember me
            </label>
          </div>

          <button class="login-btn" type="submit" id="loginSubmitBtn">
            Log In
          </button>

          <div class="login-forgot">
            <a href="/forgotpassword">
              <i class="mdi mdi-lock-outline"></i>
              Forgot your password?
            </a>
          </div>
        </form>
      </div>
    </div>

    <p class="login-footer-text">&copy; <%= new Date().getFullYear() %> eFinance. All rights reserved.</p>
  </div>
</div>

<%- contentFor('FooterJs') %>
<script>
  const setToken = (value) => {
    localStorage.setItem("accessToken", value);
  };

  const setUserType = (value) => {
    localStorage.setItem("userType", value);
  };

  const setPermissions = (value) => {
    localStorage.setItem("permissions", JSON.stringify(value));
  };

  $(document).ready(function () {
    $("#password-addon").on("click", function () {
      const passwordInput = $("#password");
      const icon = $(this).find("i");

      if (passwordInput.attr("type") === "password") {
        passwordInput.attr("type", "text");
        icon.removeClass("mdi-eye-outline").addClass("mdi-eye-off-outline");
      } else {
        passwordInput.attr("type", "password");
        icon.removeClass("mdi-eye-off-outline").addClass("mdi-eye-outline");
      }
    });

    $("#loginForm").submit(function (event) {
      event.preventDefault();

      const submitBtn = $("#loginSubmitBtn");
      const username = $("#username").val();
      const password = $("#password").val();

      submitBtn.prop("disabled", true).text("Signing in...");

      $.ajax({
        type: "POST",
        url: `/login`,
        data: {
          username: username,
          password: password,
        },
        success: function (response) {
          setToken(response.user.token);
          setPermissions(response.user.permissions);
          setUserType(response.user.user.user_type);
          if (response.user.user.user_type === "Admin") {
            window.location.href = "/companies";
          } else {
            localStorage.setItem("company_id", response.user.user.company_id);
            window.location.href = `/companies/${response.user.user.company_id}/accounts`;
          }
        },
        error: function (error) {
          submitBtn.prop("disabled", false).text("Log In");
          if (error.responseJSON) {
            toastr.error(
              error.responseJSON.message ||
                "An error occurred, please try again.",
              "Error"
            );
          } else {
            toastr.error("An error occurred, please try again.", "Error");
          }
        },
      });
    });
  });
</script>
