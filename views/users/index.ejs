<%- contentFor('HeaderCss') %>
<%- include ('../partials/title-meta', {"title":"Users"}) %>
<link href="/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/libs/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/css/accounts-page.css" rel="stylesheet" type="text/css" />
<link href="/assets/css/users-page.css" rel="stylesheet" type="text/css" />

<%- contentFor('body') %>

<div class="accounts-page users-page">
  <div class="accounts-page-header">
    <div>
      <p class="accounts-page-eyebrow">Administration</p>
      <h1 class="accounts-page-title">Users Table</h1>
      <p class="accounts-page-desc">Manage company users, access, and account status</p>
    </div>
    <div class="accounts-header-actions">
      <button class="accounts-header-btn accounts-header-btn-primary" id="openModal">
        <i class="mdi mdi-plus"></i>
        Add User
      </button>
    </div>
  </div>

  <div class="accounts-stats-row">
    <div class="accounts-stat-card">
      <div class="stat-icon count">
        <i class="mdi mdi-account-group-outline"></i>
      </div>
      <div>
        <span class="stat-value" id="totalUsersCount">0</span>
        <span class="stat-label">Total Users</span>
      </div>
    </div>
  </div>

  <div class="accounts-table-card">
    <div class="accounts-table-card-header">
      <div>
        <h5><i class="mdi mdi-shield-account-outline"></i> All Users</h5>
        <p>Toggle status, edit details, or manage permissions</p>
      </div>
    </div>
    <div class="accounts-table-body">
      <table id="datatable" class="table users-table dt-responsive nowrap w-100 mb-0">
        <thead>
          <tr>
            <th>Username</th>
            <th>Name</th>
            <th>Status</th>
            <th>Created At</th>
            <th>Last Login</th>
            <th>Last IP</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </div>
</div>

<div class="modal fade accounts-modal" id="userModal" tabindex="-1" aria-labelledby="userModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <div class="modal-title-icon">
            <i class="mdi mdi-account-plus-outline"></i>
          </div>
          <div>
            <h5 class="modal-title" id="userModalTitle">New User</h5>
            <p class="modal-subtitle">Create or update a company user</p>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="modalForm">
          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <input type="hidden" id="user_id" />
                <label for="name" class="form-label">Name</label>
                <input type="text" class="form-control" id="name" required />
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input type="text" class="form-control" id="username" required />
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input type="password" class="form-control" id="password" required />
              </div>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-cancel" id="closeModalButton" data-bs-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-submit" id="userSubmitBtn" form="modalForm">Submit</button>
      </div>
    </div>
  </div>
</div>

<%- contentFor('FooterJs') %>
<script src="/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="/assets/libs/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
<script src="/assets/libs/datatables.net-responsive-bs4/js/responsive.bootstrap4.min.js"></script>

<script>
  const storedUserToken = localStorage.getItem("accessToken");

  $(document).ready(function () {
    const companyId = window.location.pathname.split("/")[2];
    const storedCompanyId = localStorage.getItem("company_id");

    const dataTable = $("#datatable").DataTable({
      pageLength: 10,
      lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "All"]],
      paging: true,
      searching: true,
      autoWidth: false,
      order: [],
      createdRow: function (row) {
        $("td", row).eq(2).addClass("user-status-cell");
      },
    });

    function setSubmitLoading($btn, loading) {
      if (loading) {
        $btn.prop("disabled", true).html('<i class="mdi mdi-loading mdi-spin"></i><span>Submitting...</span>');
      } else {
        $btn.prop("disabled", false).html("Submit");
      }
    }

    function formatDate(value) {
      if (!value) return '<span class="user-ip-empty">—</span>';
      const date = new Date(value);
      if (isNaN(date.getTime())) return `<span class="user-date-badge">${value}</span>`;
      const formatted = date.toLocaleString();
      return `<span class="user-date-badge"><i class="mdi mdi-calendar-clock"></i>${formatted}</span>`;
    }

    function formatName(name) {
      const initial = (name || "?").charAt(0).toUpperCase();
      return `<div class="user-name-cell"><span class="user-avatar">${initial}</span><span class="user-name-text">${name || "—"}</span></div>`;
    }

    function formatIp(ip) {
      if (!ip) return '<span class="user-ip-empty">—</span>';
      return `<span class="user-ip-badge"><i class="mdi mdi-ip-network-outline"></i>${ip}</span>`;
    }

    function formatStatus(user) {
      const isActive = user.status === false;
      const switchChecked = isActive ? "checked" : "";
      const stateClass = isActive ? "active" : "suspended";
      const label = isActive ? "Active" : "Suspended";
      const icon = isActive ? "mdi-check-circle" : "mdi-pause-circle";
      return `<label class="user-status-chip ${stateClass}" for="user-status-${user.id}">
        <input type="checkbox" class="status-switch" id="user-status-${user.id}" data-id="${user.id}" ${switchChecked} />
        <span class="user-status-chip-face">
          <i class="mdi ${icon}"></i>
          <span>${label}</span>
        </span>
      </label>`;
    }

    function fetchUsersTable() {
      $.ajax({
        type: "GET",
        headers: {
          "Content-Type": "application/json",
          Authorization: `${storedUserToken}`,
        },
        url: `/companies/${companyId}/users/ajax?user_type=Company`,
        success: function (response) {
          dataTable.clear();

          response.users.forEach(function (user) {
            dataTable.row.add([
              `<span class="user-username-badge"><i class="mdi mdi-at"></i>${user.username}</span>`,
              formatName(user.name),
              formatStatus(user),
              formatDate(user.createdAt),
              formatDate(user.last_login),
              formatIp(user.last_ip),
              `<div class="user-actions">
                <button class="user-lock-btn lock-btn" data-id="${user.id}" title="Manage access">
                  <i class="mdi mdi-shield-key-outline"></i>
                </button>
                <button class="user-edit-btn edit-btn" data-id="${user.id}" data-name="${user.name || ""}" title="Edit user">
                  <i class="mdi mdi-pencil-outline"></i>
                </button>
              </div>`,
            ]);
          });

          $("#totalUsersCount").text(response.users.length);
          dataTable.draw();
        },
        error: function (error) {
          console.log(error);
        },
      });
    }

    $(document).on("click", ".lock-btn", function () {
      window.location.href = `/companies/${storedCompanyId}/user/${$(this).data("id")}`;
    });

    $(document).on("change", ".status-switch", function () {
      const $input = $(this);
      const userId = $input.data("id");
      const newStatus = $input.prop("checked") ? 0 : 1;
      const $chip = $input.closest(".user-status-chip");
      const isActive = $input.prop("checked");

      $chip
        .toggleClass("active suspended", false)
        .addClass(isActive ? "active" : "suspended")
        .find(".user-status-chip-face i")
        .attr("class", `mdi ${isActive ? "mdi-check-circle" : "mdi-pause-circle"}`)
        .end()
        .find(".user-status-chip-face span")
        .text(isActive ? "Active" : "Suspended");

      $.ajax({
        type: "post",
        url: `/companies/${companyId}/user/${userId}/status`,
        data: { status: newStatus },
        success: function (updateResponse) {
          toastr.success(updateResponse.message, "Success");
        },
        error: function (error) {
          console.error("Error updating user status:", error);
          const revertActive = !$input.prop("checked");
          $input.prop("checked", revertActive);
          $chip
            .toggleClass("active suspended", false)
            .addClass(revertActive ? "active" : "suspended")
            .find(".user-status-chip-face i")
            .attr("class", `mdi ${revertActive ? "mdi-check-circle" : "mdi-pause-circle"}`)
            .end()
            .find(".user-status-chip-face span")
            .text(revertActive ? "Active" : "Suspended");
        },
      });
    });

    const modal = new bootstrap.Modal(document.getElementById("userModal"), { keyboard: false });

    function resetUserModal() {
      $("#modalForm")[0].reset();
      $("#user_id").val("");
      $("#userModalTitle").text("New User");
      $("#username").closest(".col-md-6").show().find("#username").attr("required", true);
      $("#password").attr("required", true);
    }

    $(document).on("click", ".edit-btn", function () {
      $("#user_id").val($(this).data("id"));
      $("#name").val($(this).data("name"));
      $("#userModalTitle").text("Edit User");
      $("#username").closest(".col-md-6").hide();
      $("#username").removeAttr("required");
      $("#password").removeAttr("required");
      modal.show();
    });

    $("#openModal").click(function () {
      resetUserModal();
      modal.show();
    });

    $("#closeModalButton").click(function () {
      modal.hide();
    });

    $("#userModal").on("hidden.bs.modal", function () {
      resetUserModal();
      setSubmitLoading($("#userSubmitBtn"), false);
    });

    $(window).click(function (event) {
      if ($(event.target).is(modal._element)) modal.hide();
    });

    $("#modalForm").submit(function (event) {
      event.preventDefault();
      const submitBtn = $("#userSubmitBtn");
      setSubmitLoading(submitBtn, true);

      $.ajax({
        type: "POST",
        url: `/companies/${storedCompanyId}/users`,
        data: {
          userId: $("#user_id").val(),
          name: $("#name").val(),
          company_id: storedCompanyId,
          username: $("#username").val(),
          password: $("#password").val(),
          user_type: "Company",
        },
        success: function () {
          modal.hide();
          location.reload();
        },
        error: function () {
          alert("Error submitting the user. Please try again.");
        },
        complete: function () {
          setSubmitLoading(submitBtn, false);
        },
      });
    });

    if (storedCompanyId) {
      showSidebarLinks(storedCompanyId);
    }

    fetchUsersTable();
  });
</script>
