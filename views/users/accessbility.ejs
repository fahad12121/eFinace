<%- contentFor('HeaderCss') %>
<%- include ('../partials/title-meta', {"title":"Accessibility"}) %>
<link href="/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/libs/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/css/accounts-page.css" rel="stylesheet" type="text/css" />
<link href="/assets/css/accessibility-page.css" rel="stylesheet" type="text/css" />

<%- contentFor('body') %>

<%
  const modules = [
    { name: 'accounts', label: 'Accounts', icon: 'mdi-account-group-outline' },
    { name: 'transactions', label: 'Transactions', icon: 'mdi-swap-horizontal-bold' },
    { name: 'account_types', label: 'Account Types', icon: 'mdi-layers-outline' },
    { name: 'balance_sheet', label: 'Balance Sheet', icon: 'mdi-scale-balance' },
    { name: 'import', label: 'Import', icon: 'mdi-upload-outline' }
  ];

  let grantedCount = 0;

  modules.forEach(function(module) {
    let moduleData = accessibility[module.name] || {};
    if (typeof moduleData === 'string') {
      moduleData = JSON.parse(moduleData);
    }
    if (module.name !== 'import' && moduleData.view_only === true) grantedCount++;
    if (module.name !== 'import' && module.name !== 'balance_sheet' && moduleData.edit === true) grantedCount++;
    if (module.name !== 'balance_sheet' && moduleData.add === true) grantedCount++;
  });
%>

<div class="accounts-page accessibility-page">
  <div class="accounts-page-header">
    <div>
      <p class="accounts-page-eyebrow">User Management</p>
      <h1 class="accounts-page-title">Accessibility</h1>
      <p class="accounts-page-desc">Configure module permissions for this user</p>
    </div>
    <div class="accounts-header-actions">
      <a href="/companies/<%= company_id %>/users" class="accounts-header-btn accounts-header-btn-secondary">
        <i class="mdi mdi-arrow-left"></i>
        Back to Users
      </a>
      <a href="/companies/<%= company_id %>/user/<%= user_id %>/account-access" class="accounts-header-btn accounts-header-btn-primary">
        <i class="mdi mdi-account-key-outline"></i>
        Account Access
      </a>
    </div>
  </div>

  <div class="accounts-stats-row">
    <div class="accounts-stat-card">
      <div class="stat-icon modules">
        <i class="mdi mdi-view-grid-outline"></i>
      </div>
      <div>
        <span class="stat-value"><%= modules.length %></span>
        <span class="stat-label">Modules</span>
      </div>
    </div>
    <div class="accounts-stat-card">
      <div class="stat-icon granted">
        <i class="mdi mdi-shield-check-outline"></i>
      </div>
      <div>
        <span class="stat-value" id="grantedPermissionsCount"><%= grantedCount %></span>
        <span class="stat-label">Permissions Granted</span>
      </div>
    </div>
  </div>

  <div class="accounts-table-card">
    <div class="accounts-table-card-header">
      <div>
        <h5><i class="mdi mdi-shield-lock-outline"></i> Module Permissions</h5>
        <p>Toggle view, edit, and add access per module — changes save automatically</p>
      </div>
    </div>
    <div class="accounts-table-body">
      <table id="datatable" class="table accessibility-table dt-responsive nowrap w-100 mb-0">
        <thead>
          <tr>
            <th>Module</th>
            <th class="perm-col"><i class="mdi mdi-eye-outline"></i> View</th>
            <th class="perm-col"><i class="mdi mdi-pencil-outline"></i> Edit</th>
            <th class="perm-col"><i class="mdi mdi-plus"></i> Add</th>
          </tr>
        </thead>
        <tbody>
          <% modules.forEach(function(module) { %>
            <%
              let moduleData = accessibility[module.name] || {};
              if (typeof moduleData === 'string') {
                moduleData = JSON.parse(moduleData);
              }
            %>
            <tr>
              <td>
                <div class="acc-module-cell">
                  <div class="acc-module-icon <%= module.name %>">
                    <i class="mdi <%= module.icon %>"></i>
                  </div>
                  <div>
                    <span class="acc-module-name"><%= module.label %></span>
                    <span class="acc-module-key"><%= module.name.replace(/_/g, ' ') %></span>
                  </div>
                </div>
              </td>

              <td class="perm-cell">
                <% if (module.name !== 'import') { %>
                  <label class="perm-toggle">
                    <input
                      type="checkbox"
                      class="permission-checkbox"
                      data-module="<%= module.name %>"
                      data-permission="view_only"
                      <% if (moduleData.view_only === true) { %> checked <% } %>
                    />
                    <span class="perm-toggle-face"><i class="mdi mdi-check-bold"></i></span>
                  </label>
                <% } else { %>
                  <span class="perm-na" title="Not applicable">—</span>
                <% } %>
              </td>

              <td class="perm-cell">
                <% if (module.name !== 'import' && module.name !== 'balance_sheet') { %>
                  <label class="perm-toggle">
                    <input
                      type="checkbox"
                      class="permission-checkbox"
                      data-module="<%= module.name %>"
                      data-permission="edit"
                      <% if (moduleData.edit === true) { %> checked <% } %>
                    />
                    <span class="perm-toggle-face"><i class="mdi mdi-check-bold"></i></span>
                  </label>
                <% } else { %>
                  <span class="perm-na" title="Not applicable">—</span>
                <% } %>
              </td>

              <td class="perm-cell">
                <% if (module.name !== 'balance_sheet') { %>
                  <label class="perm-toggle">
                    <input
                      type="checkbox"
                      class="permission-checkbox"
                      data-module="<%= module.name %>"
                      data-permission="add"
                      <% if (moduleData.add === true) { %> checked <% } %>
                    />
                    <span class="perm-toggle-face"><i class="mdi mdi-check-bold"></i></span>
                  </label>
                <% } else { %>
                  <span class="perm-na" title="Not applicable">—</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- contentFor('FooterJs') %>
<script src="/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="/assets/libs/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
<script src="/assets/libs/datatables.net-responsive-bs4/js/responsive.bootstrap4.min.js"></script>
<script src="/assets/js/pages/datatables.init.js"></script>
<script>
  $(document).ready(function () {
    var storedCompanyId = localStorage.getItem("company_id");

    if (storedCompanyId) {
      showSidebarLinks(storedCompanyId);
    }

    function updateGrantedCount() {
      var count = $(".permission-checkbox:checked").length;
      $("#grantedPermissionsCount").text(count);
    }

    $(document).on("change", ".permission-checkbox", function () {
      var $toggle = $(this).closest(".perm-toggle");
      var module = $(this).data("module");
      var permission = $(this).data("permission");
      var isChecked = $(this).prop("checked");
      var user_id = window.location.pathname.split("/")[4];

      $toggle.addClass("is-saving");

      $.ajax({
        type: "POST",
        url: "/companies/" + storedCompanyId + "/users/" + user_id + "/accessibility",
        data: {
          user_id: user_id,
          resource: module,
          action: permission,
          is_checked: isChecked,
        },
        success: function () {
          updateGrantedCount();
        },
        error: function (error) {
          console.error("Error updating permission:", error);
        },
        complete: function () {
          $toggle.removeClass("is-saving");
        },
      });
    });
  });
</script>
