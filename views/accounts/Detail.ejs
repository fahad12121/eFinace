<%- contentFor('HeaderCss') %>
<%- include ('../partials/title-meta', {"title":"Account Detail"}) %>
<link href="/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/libs/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/libs/select2/css/select2.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/css/accounts-page.css" rel="stylesheet" type="text/css" />
<link href="/assets/css/account-detail-page.css" rel="stylesheet" type="text/css" />

<%- contentFor('body') %>

<% const displayName = account.username.charAt(0).toUpperCase() + account.username.slice(1); %>
<% const accountInitial = account.username.charAt(0).toUpperCase(); %>
<% const subCount = account.subAccounts.length; %>
<% const roundedTotal = Math.round(totalBalance); %>
<% const totalBalanceClass = roundedTotal > 0 ? 'positive' : roundedTotal < 0 ? 'negative' : 'zero'; %>

<div class="accounts-page account-detail-page">
  <div class="accounts-page-header">
    <div>
      <p class="accounts-page-eyebrow">Account</p>
      <h1 class="accounts-page-title"><%= displayName %> Account Detail</h1>
      <p class="accounts-page-desc">View and manage sub-accounts linked to this account</p>
    </div>
  </div>

  <div class="account-detail-hero">
    <span class="account-detail-avatar"><%= accountInitial %></span>
    <div>
      <h2 class="account-detail-name"><%= displayName %></h2>
      <p class="account-detail-meta">Account ID: <%= account.account_pk %> · <%= subCount %> sub-account<%= subCount === 1 ? '' : 's' %></p>
    </div>
  </div>

  <div class="accounts-stats-row">
    <div class="accounts-stat-card">
      <div class="stat-icon count">
        <i class="mdi mdi-account-multiple-outline"></i>
      </div>
      <div>
        <span class="stat-value"><%= subCount %></span>
        <span class="stat-label">Sub Accounts</span>
      </div>
    </div>
    <div class="accounts-stat-card">
      <div class="stat-icon balance">
        <i class="mdi mdi-scale-balance"></i>
      </div>
      <div>
        <span class="stat-value"><%= roundedTotal.toLocaleString() %></span>
        <span class="stat-label">Total Balance</span>
        <span class="stat-hint <%= roundedTotal >= 0 ? 'positive' : 'negative' %>">
          <%= roundedTotal >= 0 ? 'Net positive' : 'Net negative' %>
        </span>
      </div>
    </div>
  </div>

  <div class="accounts-table-card">
    <div class="accounts-table-card-header">
      <div>
        <h5><i class="mdi mdi-format-list-bulleted"></i> Sub Accounts</h5>
        <p>Edit sub-accounts or open account statements</p>
      </div>
      <span class="account-detail-count-badge"><%= subCount %> accounts</span>
    </div>
    <div class="accounts-table-body is-loading">
      <div class="accounts-table-loader" id="subAccountsTableLoader">
        <div class="accounts-loader-inner">
          <i class="mdi mdi-loading mdi-spin"></i>
          <span>Loading sub-accounts...</span>
        </div>
      </div>
      <div class="table-responsive">
        <table id="subdatatable" class="table accounts-table dt-responsive nowrap w-100 mb-0">
          <thead>
            <tr>
              <th>#</th>
              <th>Title</th>
              <th>Balance</th>
              <th>Account Type</th>
              <th>Notes</th>
              <th>Updated At</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% account.subAccounts.forEach(function(sub) { %>
            <% const balance = Math.round(parseFloat(sub.balance === null ? 0 : String(sub.balance).replace(/,/g, ''))); %>
            <% const balanceClass = balance > 0 ? 'positive' : balance < 0 ? 'negative' : 'zero'; %>
            <% const subInitial = (sub.account_username || '?').charAt(0).toUpperCase(); %>
            <tr>
              <td><span class="acct-id-badge"><%= sub.sub_account_pk %></span></td>
              <td>
                <div class="acct-title-cell">
                  <span class="acct-avatar"><%= subInitial %></span>
                  <span class="acct-title-text"><%= sub.account_username %></span>
                </div>
              </td>
              <td>
                <span class="acct-balance-badge <%= balanceClass %>">
                  <%= balance.toLocaleString() %>
                </span>
              </td>
              <td>
                <span class="acct-type-badge">
                  <i class="mdi mdi-web"></i>
                  <%= sub?.AccountType?.name || 'N/A' %>
                </span>
              </td>
              <td>
                <% if (sub.notes) { %>
                <span class="acct-notes-text" title="<%= sub.notes %>">
                  <i class="mdi mdi-note-text-outline"></i>
                  <%= sub.notes %>
                </span>
                <% } else { %>
                <span class="acct-notes-empty">—</span>
                <% } %>
              </td>
              <td>
                <% if (sub.updatedAt) { %>
                <% const updatedAt = new Date(sub.updatedAt); %>
                <span class="acct-date-badge" data-order="<%= updatedAt.getTime() %>">
                  <i class="mdi mdi-calendar-clock"></i>
                  <%= formatRelativeDate(sub.updatedAt) %>
                </span>
                <% } else { %>
                <span class="acct-date-empty">—</span>
                <% } %>
              </td>
              <td>
                <div class="acct-actions">
                  <button
                    class="acct-edit-btn edit-btn"
                    data-id="<%= sub.id %>"
                    data-username="<%= sub.account_username %>"
                    title="Edit"
                  >
                    <i class="mdi mdi-pencil-outline"></i>
                  </button>
                  <button
                    class="acct-stmt-btn st-btn"
                    data-id="<%= sub.id %>"
                    title="Account Statement"
                  >
                    <i class="mdi mdi-file-document-outline"></i>
                    Statement
                  </button>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
          <tfoot>
            <tr>
              <th></th>
              <th>Total</th>
              <th>
                <span class="acct-total-value acct-balance-badge <%= totalBalanceClass %>">
                  <%= roundedTotal.toLocaleString() %>
                </span>
              </th>
              <th colspan="4"></th>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="modal fade accounts-modal" id="subAccountModal" tabindex="-1" aria-labelledby="subAccountModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <div class="modal-title-icon sub">
            <i class="mdi mdi-pencil-outline"></i>
          </div>
          <div>
            <h5 class="modal-title" id="subAccountModalTitle">Edit Sub Account</h5>
            <p class="modal-subtitle">Update sub-account details</p>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="subAccountmodalForm">
          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <input type="hidden" id="id" name="id" />
                <label for="account_username" class="form-label">Title</label>
                <input type="text" class="form-control" id="account_username" name="account_username" />
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <label for="sub_notes" class="form-label">Notes</label>
                <input type="text" class="form-control" id="sub_notes" name="sub_notes" />
              </div>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-cancel" id="closeModalButton" data-bs-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-submit" id="subAccountSubmitBtn" form="subAccountmodalForm">Submit</button>
      </div>
    </div>
  </div>
</div>

<%- contentFor('FooterJs') %>
<script src="/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="/assets/libs/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
<script src="/assets/libs/datatables.net-responsive-bs4/js/responsive.bootstrap4.min.js"></script>
<script src="/assets/libs/select2/js/select2.min.js"></script>

<script>
  $(document).ready(function () {
    function setTableLoading(loading) {
      const $loader = $("#subAccountsTableLoader");
      const $body = $(".account-detail-page .accounts-table-body");

      if (loading) {
        $loader.removeClass("is-hidden");
        $body.addClass("is-loading");
      } else {
        $loader.addClass("is-hidden");
        $body.removeClass("is-loading");
      }
    }

    setTableLoading(true);

    $("#subdatatable").DataTable({
      pageLength: 120,
      lengthMenu: [[120, 50, 100, -1], [120, 50, 100, "All"]],
      paging: true,
      searching: true,
      autoWidth: false,
      order: [],
      initComplete: function () {
        setTableLoading(false);
      },
    });

    function getCompanyIdFromUrl() {
      return window.location.pathname.split("/")[2];
    }

    function setSubmitLoading($btn, loading) {
      if (loading) {
        $btn.prop("disabled", true).html(
          '<i class="mdi mdi-loading mdi-spin"></i><span>Submitting...</span>'
        );
      } else {
        $btn.prop("disabled", false).html("Submit");
      }
    }

    const subAccountModal = new bootstrap.Modal(document.getElementById("subAccountModal"), { keyboard: false });

    $(document).on("click", ".edit-btn", function () {
      const userId = $(this).data("id");
      const username = $(this).data("username");
      $("#id").val(userId);
      $("#account_username").val(username);
      $("#subAccountModalTitle").text("Edit Sub Account");

      const usernameInput = $("#account_username");
      if (username === "DASTI") {
        usernameInput.closest(".col-md-6").hide();
      } else {
        usernameInput.closest(".col-md-6").show();
      }

      subAccountModal.show();
    });

    $(document).on("click", ".st-btn", function () {
      const userId = $(this).data("id");
      window.location.href = `/companies/${getCompanyIdFromUrl()}/accounts/${userId}/account_statements`;
    });

    $("#subAccountModal").on("hidden.bs.modal", function () {
      $("#subAccountmodalForm")[0].reset();
      $("#id").val("");
      $("#account_username").closest(".col-md-6").show();
      setSubmitLoading($("#subAccountSubmitBtn"), false);
    });

    $("#subAccountmodalForm").submit(function (event) {
      event.preventDefault();

      const submitBtn = $("#subAccountSubmitBtn");
      setSubmitLoading(submitBtn, true);

      $.ajax({
        type: "POST",
        url: `/companies/${getCompanyIdFromUrl()}/sub_accounts`,
        data: {
          id: $("#id").val(),
          notes: $("#sub_notes").val(),
          account_username: $("#account_username").val(),
        },
        success: function () {
          location.reload();
        },
        error: function () {
          alert("Error submitting the sub-account. Please try again.");
        },
        complete: function () {
          setSubmitLoading(submitBtn, false);
        },
      });
    });

    const storedCompanyId = localStorage.getItem("company_id");
    if (storedCompanyId) {
      showSidebarLinks(storedCompanyId);
    }
  });
</script>
