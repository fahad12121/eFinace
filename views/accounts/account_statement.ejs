<%- contentFor('HeaderCss') %>
<%- include ('../partials/title-meta', {"title":"Account Statement"}) %>
<link href="/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/libs/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/css/accounts-page.css" rel="stylesheet" type="text/css" />
<link href="/assets/css/account-statement-page.css" rel="stylesheet" type="text/css" />

<%- contentFor('body') %>

<div class="accounts-page statement-page">
  <div class="accounts-page-header">
    <div>
      <p class="accounts-page-eyebrow">Reports</p>
      <h1 class="accounts-page-title">Account Statement</h1>
      <p class="accounts-page-desc">Review transactions, debits, credits, and running balance</p>
    </div>
  </div>

  <div class="accounts-stats-row">
    <div class="accounts-stat-card">
      <div class="stat-icon minus">
        <i class="mdi mdi-arrow-down-bold-circle-outline"></i>
      </div>
      <div>
        <span class="stat-value" id="statTotalMinus">0</span>
        <span class="stat-label">Total Minus</span>
      </div>
    </div>
    <div class="accounts-stat-card">
      <div class="stat-icon plus">
        <i class="mdi mdi-arrow-up-bold-circle-outline"></i>
      </div>
      <div>
        <span class="stat-value" id="statTotalPlus">0</span>
        <span class="stat-label">Total Plus</span>
      </div>
    </div>
    <div class="accounts-stat-card">
      <div class="stat-icon balance">
        <i class="mdi mdi-scale-balance"></i>
      </div>
      <div>
        <span class="stat-value" id="statTotalBalance">0</span>
        <span class="stat-label">Final Balance</span>
      </div>
    </div>
  </div>

  <div class="accounts-table-card">
    <div class="accounts-table-card-header">
      <div>
        <h5><i class="mdi mdi-file-document-outline"></i> Account Statements</h5>
        <p>Filter by date range to load statement entries</p>
      </div>
    </div>

    <div class="statement-filter-bar">
      <div class="statement-filter-group">
        <label for="start_date">From</label>
        <input type="date" id="start_date" name="start_date" autocomplete="off" />
      </div>
      <div class="statement-filter-group">
        <label for="end_date">To</label>
        <input type="date" id="end_date" name="end_date" autocomplete="off" />
      </div>
      <button type="button" class="statement-search-btn" id="searchStatementBtn">
        <i class="mdi mdi-magnify"></i>
        Search
      </button>
    </div>

    <div class="accounts-table-body">
      <div class="table-responsive">
        <table id="transaction" class="table statement-table dt-responsive nowrap w-100 mb-0">
          <thead>
            <tr>
              <th>Date</th>
              <th>Account</th>
              <th>Sub-Account</th>
              <th>Narration</th>
              <th>Minus</th>
              <th>Plus</th>
              <th>Balance</th>
            </tr>
          </thead>
          <tbody></tbody>
          <tfoot>
            <tr>
              <th colspan="4">Total</th>
              <th><span id="total_minus" class="stmt-total-value minus"></span></th>
              <th><span id="total_plus" class="stmt-total-value plus"></span></th>
              <th><span id="total_balance" class="stmt-total-value balance"></span></th>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </div>
</div>

<%- contentFor('FooterJs') %>
<script src="/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="/assets/libs/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
<script src="/assets/libs/datatables.net-responsive-bs4/js/responsive.bootstrap4.min.js"></script>

<script>
  $(document).ready(function () {
    const dataTable = $("#transaction").DataTable({
      order: [],
      pageLength: 120,
      lengthMenu: [[120, 50, 100, -1], [120, 50, 100, "All"]],
      paging: true,
      searching: true,
      autoWidth: false,
    });

    let subAccountsArray = [];
    const storedCompanyId = localStorage.getItem("company_id");
    const searchBtn = $("#searchStatementBtn");

    function getAccountIdFromUrl() {
      return window.location.pathname.split("/")[4];
    }

    function balanceClass(value) {
      const num = Math.round(parseFloat(value) || 0);
      if (num > 0) return "positive";
      if (num < 0) return "negative";
      return "zero";
    }

    function formatDateBadge(date) {
      return `<span class="stmt-date-badge"><i class="mdi mdi-calendar-outline"></i>${date}</span>`;
    }

    function formatMinusBadge(amount) {
      const num = parseFloat(amount);
      if (!num || num >= 0) return `<span class="stmt-empty">—</span>`;
      return `<span class="stmt-amount-badge minus">${Math.round(num).toLocaleString()}</span>`;
    }

    function formatPlusBadge(amount) {
      const num = parseFloat(amount);
      if (!num || num <= 0) return `<span class="stmt-empty">—</span>`;
      return `<span class="stmt-amount-badge plus">${Math.round(num).toLocaleString()}</span>`;
    }

    function formatBalanceBadge(balance) {
      const num = parseFloat(balance) || 0;
      const cls = balanceClass(num);
      return `<span class="stmt-amount-badge balance ${cls}">${Math.round(num).toLocaleString()}</span>`;
    }

    function formatNarration(text) {
      if (!text) return `<span class="stmt-empty">—</span>`;
      const escaped = String(text).replace(/"/g, "&quot;");
      return `<span class="stmt-narration" title="${escaped}"><i class="mdi mdi-text-box-outline"></i>${text}</span>`;
    }

    function setSearchLoading(loading) {
      if (loading) {
        searchBtn.prop("disabled", true).html(
          '<i class="mdi mdi-loading mdi-spin"></i><span>Loading...</span>'
        );
      } else {
        searchBtn.prop("disabled", false).html(
          '<i class="mdi mdi-magnify"></i> Search'
        );
      }
    }

    function updateStats(totalMinus, totalPlus, totalBalance) {
      const minusFormatted = Math.round(totalMinus).toLocaleString();
      const plusFormatted = Math.round(totalPlus).toLocaleString();
      const balanceFormatted = Math.round(totalBalance).toLocaleString();

      $("#statTotalMinus").text(minusFormatted);
      $("#statTotalPlus").text(plusFormatted);
      $("#statTotalBalance").text(balanceFormatted);
      $("#total_minus").text(minusFormatted);
      $("#total_plus").text(plusFormatted);
      $("#total_balance").text(balanceFormatted);
    }

    function getOpeningBalance(subAccountsArray) {
      let openingBalanceDate = "";
      const startDate = $('input[name="start_date"]').val();
      const endDate = $('input[name="end_date"]').val();

      if (!startDate || !endDate) {
        openingBalanceDate = new Date().toISOString().split("T")[0];
      } else {
        openingBalanceDate = startDate.split("T")[0];
      }

      let openingBalance = 0;
      if (subAccountsArray?.length > 0) {
        const openingRow = subAccountsArray[0];
        openingBalance =
          parseFloat(openingRow.account_statement_balance) -
          parseFloat(openingRow.account_statement_amount);
      }

      return [openingBalance, openingBalanceDate];
    }

    function fetchAccountStatement(startDate, endDate) {
      setSearchLoading(true);

      $.ajax({
        type: "GET",
        url: `/companies/${storedCompanyId}/accounts/${getAccountIdFromUrl()}/account_statements/ajax`,
        data: {
          startDate: startDate,
          endDate: endDate,
          account_id: getAccountIdFromUrl(),
        },
        success: function (response) {
          subAccountsArray = response.sub_account;
          dataTable.clear();

          let totalMinus = 0;
          let totalPlus = 0;
          let totalBalance = 0;

          const [openingBalance, openingBalanceDate] = getOpeningBalance(subAccountsArray);
          const openingFormatted = parseFloat(openingBalance) || 0;

          dataTable.row.add([
            formatDateBadge(openingBalanceDate),
            `<span class="stmt-ob-badge">O/B</span>`,
            `<span class="stmt-empty">—</span>`,
            formatNarration("Opening Balance"),
            formatMinusBadge(openingFormatted),
            formatPlusBadge(openingFormatted),
            formatBalanceBadge(openingFormatted),
          ]);

          response.sub_account.forEach(function (account) {
            const amount = parseFloat(account.account_statement_amount);

            dataTable.row.add([
              formatDateBadge(account.account_statement_date),
              `<span class="stmt-text">${account.receiver_user || "—"}</span>`,
              `<span class="stmt-sub-text">${account.receiver_sub_account_username || "—"}</span>`,
              formatNarration(account.account_statement_narration),
              formatMinusBadge(amount),
              formatPlusBadge(amount),
              formatBalanceBadge(account.account_statement_balance),
            ]);

            if (amount < 0) totalMinus += amount;
            if (amount > 0) totalPlus += amount;
            totalBalance += parseFloat(account.account_statement_balance);
          });

          updateStats(totalMinus, totalPlus, totalBalance);
          dataTable.draw();

          $("#transaction tbody tr:first").addClass("stmt-opening-row");
        },
        error: function (error) {
          console.log(error);
        },
        complete: function () {
          setSearchLoading(false);
        },
      });
    }

    function searchStatement() {
      const startDate = $('input[name="start_date"]').val();
      const endDate = $('input[name="end_date"]').val();
      fetchAccountStatement(startDate || "", endDate || "");
    }

    $("#searchStatementBtn").on("click", searchStatement);

    searchStatement();

    if (storedCompanyId) {
      showSidebarLinks(storedCompanyId);
    }
  });
</script>
