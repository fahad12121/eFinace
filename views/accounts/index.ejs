<%- contentFor('HeaderCss') %>
<%- include ('../partials/title-meta', {"title":"Accounts"}) %>
<link href="/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/libs/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/libs/select2/css/select2.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/css/accounts-page.css" rel="stylesheet" type="text/css" />

<%- contentFor('body') %>

<div class="accounts-page">
  <div class="accounts-page-header">
    <div>
      <p class="accounts-page-eyebrow">Management</p>
      <h1 class="accounts-page-title">Accounts Table</h1>
      <p class="accounts-page-desc">Browse, manage, and favourite your company accounts</p>
    </div>
    <div class="accounts-header-actions">
      <button class="accounts-header-btn accounts-header-btn-fav" id="addfavt" style="display: none">
        <i class="mdi mdi-star-outline"></i>
        Add to Favorites
      </button>
      <button class="accounts-header-btn accounts-header-btn-primary" id="openModal" style="display: none">
        <i class="mdi mdi-plus"></i>
        Add New Account
      </button>
      <button class="accounts-header-btn accounts-header-btn-secondary" id="openSubModal" style="display: none">
        <i class="mdi mdi-account-plus-outline"></i>
        Add New Sub-Account
      </button>
    </div>
  </div>

  <div class="accounts-stats-row">
    <div class="accounts-stat-card">
      <div class="stat-icon count">
        <i class="mdi mdi-account-group-outline"></i>
      </div>
      <div>
        <span class="stat-value" id="totalAccountsCount">0</span>
        <span class="stat-label">Total Accounts</span>
      </div>
    </div>
    <div class="accounts-stat-card">
      <div class="stat-icon balance">
        <i class="mdi mdi-scale-balance"></i>
      </div>
      <div>
        <span class="stat-value" id="totalBalanceStat">0</span>
        <span class="stat-label">Total Balance</span>
        <span class="stat-hint" id="totalBalanceHint"></span>
      </div>
    </div>
  </div>

  <div class="accounts-table-card">
    <div class="accounts-table-card-header">
      <div>
        <h5><i class="mdi mdi-format-list-bulleted"></i> All Accounts</h5>
        <p>Select accounts to add to favourites or open to view details</p>
      </div>
    </div>
    <div class="accounts-table-body">
      <table id="accountsTable" class="table accounts-table dt-responsive nowrap w-100 mb-0">
        <thead>
          <tr>
            <th style="width: 40px">
              <input class="acct-checkbox" type="checkbox" id="selectAllCheckbox" />
            </th>
            <th>ID</th>
            <th>Title</th>
            <th>Balance</th>
            <th>Notes</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody></tbody>
        <tfoot>
          <tr>
            <th></th>
            <th></th>
            <th>Total Balance</th>
            <th><span class="acct-total-value" id="totalBalance">0</span></th>
            <th></th>
            <th></th>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
</div>

<div class="modal fade accounts-modal" id="userModal" tabindex="-1" aria-labelledby="userModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <div class="modal-title-icon">
            <i class="mdi mdi-account-plus-outline"></i>
          </div>
          <div>
            <h5 class="modal-title" id="userModalTitle">Add Account</h5>
            <p class="modal-subtitle">Create or update an account</p>
            <span class="modal-id-tag">A/C ID: <%- account_pk %></span>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="modalForm">
          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <input type="hidden" id="userId" name="userId" />
                <label for="username" class="form-label">Title</label>
                <input type="text" class="form-control" id="username" required />
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <label for="notes" class="form-label">Notes</label>
                <input type="text" class="form-control" id="notes" />
              </div>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-cancel" id="closeModalButton" data-bs-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-submit" id="userModalSubmitBtn" form="modalForm">Submit</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade accounts-modal" id="subAccountModal" tabindex="-1" aria-labelledby="subAccountModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <div class="modal-title-icon sub">
            <i class="mdi mdi-account-multiple-plus-outline"></i>
          </div>
          <div>
            <h5 class="modal-title">Add New Sub-Account</h5>
            <p class="modal-subtitle">Link a sub-account to a parent account</p>
            <span class="modal-id-tag">S. A/C: <%- sub_account_pk %></span>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="subAccountmodalForm">
          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <label for="account_username" class="form-label">Title</label>
                <input type="text" class="form-control" id="account_username" name="account_username" required />
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <label for="account_type_id" class="form-label">Website</label>
                <select class="form-control select2 account_types" style="width: 100%" id="account_type_id" name="account_type_id">
                  <option value="" selected disabled>--Select--</option>
                </select>
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 mt-2">
              <div class="mb-3">
                <label for="user_id" class="form-label">Parent Account</label>
                <select class="form-control select2 parentAccounts" style="width: 100%" id="user_id" name="user_id">
                  <option value="" selected disabled>--Select--</option>
                </select>
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <label for="sub_notes" class="form-label">Notes</label>
                <input type="text" class="form-control" id="sub_notes" name="sub_notes" />
              </div>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-submit" id="subAccountSubmitBtn" form="subAccountmodalForm">Submit</button>
      </div>
    </div>
  </div>
</div>

<%- contentFor('FooterJs') %>
<script src="/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="/assets/libs/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
<script src="/assets/libs/datatables.net-responsive-bs4/js/responsive.bootstrap4.min.js"></script>
<script src="/assets/libs/select2/js/select2.min.js"></script>

<script>
  $(document).ready(function () {
    const dataTable = $("#accountsTable").DataTable({
      pageLength: 800,
      lengthMenu: [[800, 300, 200, -1], [800, 300, 200, "All"]],
      paging: true,
      searching: true,
      autoWidth: false,
      order: [],
    });

    const storedCompanyId = localStorage.getItem("company_id");
    const userType = localStorage.getItem("userType");

    if (userType === "Admin") {
      $("#addfavt").css("display", "inline-flex");
    } else {
      $("#addfavt").css("display", "none");
    }

    let permissions;
    if (storedCompanyId) {
      permissions = showSidebarLinks(storedCompanyId);

      if ((permissions.accounts && permissions.accounts.add == true) || userType === "Admin") {
        $("#openModal").css("display", "inline-flex");
        $("#openSubModal").css("display", "inline-flex");
      } else {
        $("#openModal").css("display", "none");
        $("#openSubModal").css("display", "none");
      }
    }

    function balanceClass(value) {
      const rounded = Math.round(parseFloat(value));
      if (rounded > 0) return "positive";
      if (rounded < 0) return "negative";
      return "zero";
    }

    function formatBalanceBadge(value) {
      const rounded = Math.round(parseFloat(value));
      const cls = balanceClass(rounded);
      return `<span class="acct-balance-badge ${cls}">${rounded.toLocaleString()}</span>`;
    }

    function formatNotes(notes) {
      if (!notes) return `<span class="acct-notes-empty">—</span>`;
      const escaped = String(notes).replace(/"/g, "&quot;");
      return `<span class="acct-notes-text" title="${escaped}"><i class="mdi mdi-note-text-outline"></i>${notes}</span>`;
    }

    function formatTitle(username) {
      const initial = (username || "?").charAt(0).toUpperCase();
      return `<div class="acct-title-cell"><span class="acct-avatar">${initial}</span><span class="acct-title-text">${username || ""}</span></div>`;
    }

    function updateBalanceStats(totalBalance, count) {
      const rounded = Math.round(totalBalance);
      const formatted = rounded.toLocaleString();
      $("#totalAccountsCount").text(count);
      $("#totalBalanceStat").text(formatted);
      $("#totalBalance").text(formatted);
      const hint = $("#totalBalanceHint");
      hint.removeClass("positive negative");
      if (rounded > 0) hint.addClass("positive").text("Net positive");
      else if (rounded < 0) hint.addClass("negative").text("Net negative");
      else hint.text("Balanced at zero");
    }

    function setSubmitLoading($btn, loading) {
      if (loading) {
        $btn.prop("disabled", true).html(
          '<i class="mdi mdi-loading mdi-spin"></i><span>Submitting...</span>'
        );
      } else {
        $btn.prop("disabled", false).html("Submit");
      }
    }

    function fetchUsersTable() {
      const companyId = storedCompanyId;
      $.ajax({
        type: "GET",
        url: `/companies/${companyId}/users/ajax?user_type=User`,
        success: function (response) {
          dataTable.clear();
          let totalBalance = 0;
          response.users.forEach(function (user) {
            let balance = user.balance === null ? 0 : user.balance;
            balance = parseFloat(balance);
            const canEdit = (permissions && permissions.accounts && permissions.accounts.edit) || userType === "Admin";

            dataTable.row.add([
              `<input type="checkbox" class="acct-checkbox fav-checkbox" data-id="${user.id}" />`,
              `<span class="acct-id-badge">${user.account_pk}</span>`,
              formatTitle(user.username),
              formatBalanceBadge(balance),
              formatNotes(user.notes),
              `<div class="acct-actions">
                <button class="acct-view-btn view-btn" data-id="${user.id}" title="View">
                  <i class="mdi mdi-eye-outline"></i>
                </button>
                ${canEdit ? `<button class="acct-edit-btn edit-btn" data-id="${user.id}" title="Edit"><i class="mdi mdi-pencil-outline"></i></button>` : ""}
              </div>`,
            ]);

            totalBalance += balance;
          });

          updateBalanceStats(totalBalance, response.users.length);
          dataTable.draw();
        },
        error: function (error) {
          console.log(error);
        },
      });
    }

    function fetchAccounttype() {
      const companyId = storedCompanyId;
      $.ajax({
        type: "GET",
        url: `/companies/${companyId}/account_types/ajax`,
        success: function (response) {
          const accountTypes = response.accountTypes;
          $(".account_types")
            .empty()
            .append('<option value="" selected disabled>--Select--</option>');

          accountTypes.forEach(function (accountType) {
            $(".account_types").append(`<option value="${accountType.id}">${accountType.name}</option>`);
          });

          $(".select2").select2();
        },
        error: function (error) {
          console.log(error);
        },
      });
    }

    function fetchParentAccount() {
      const companyId = storedCompanyId;
      $.ajax({
        type: "GET",
        url: `/companies/${companyId}/users/ajax?user_type=User`,
        success: function (response) {
          $(".parentAccounts")
            .empty()
            .append('<option value="" selected disabled>--Select--</option>');

          response.users.forEach(function (user) {
            $(".parentAccounts").append(`<option value="${user.id}">${user?.username}</option>`);
          });

          $(".select2").select2();
        },
        error: function (error) {
          console.log(error);
        },
      });
    }

    $(document).on("click", ".view-btn", function () {
      const userId = $(this).data("id");
      window.location.href = `/companies/${storedCompanyId}/accounts/${userId}`;
    });

    const modal = new bootstrap.Modal(document.getElementById("userModal"), { keyboard: false });

    $(document).on("click", ".edit-btn", function () {
      const userId = $(this).data("id");
      $("#userId").val(userId);
      modal.show();
      $("#userModalTitle").text("Edit Account");

      const usernameInput = $("#username");
      usernameInput.closest(".col-md-6").hide();
      usernameInput.removeAttr("required");
    });

    $("#selectAllCheckbox").change(function () {
      $(".fav-checkbox").prop("checked", $(this).prop("checked"));
    });

    $("#addfavt").click(function () {
      const selectedAccounts = [];
      $(".fav-checkbox:checked").each(function () {
        selectedAccounts.push($(this).data("id"));
      });

      if (selectedAccounts.length === 0) {
        toastr.error("Please select at least one account to add to favorites", "Error");
        return;
      }

      $.ajax({
        type: "POST",
        url: `/companies/${storedCompanyId}/add_to_favt`,
        data: { accounts: selectedAccounts },
        success: function (response) {
          toastr.success(response.message, "Success");
          fetchUsersTable();
        },
        error: function (error) {
          console.log(error);
          alert("Error adding accounts to favorites. Please try again.");
        },
      });
    });

    const subAccountModal = new bootstrap.Modal(document.getElementById("subAccountModal"), { keyboard: false });

    $("#openModal").click(function () {
      modal.show();
    });

    $("#openSubModal").click(function () {
      subAccountModal.show();
      $(".select2").select2({
        minimumResultsForSearch: 0,
        dropdownParent: $("#subAccountModal"),
      });
    });

    $("#closeModalButton").click(function () {
      modal.hide();
    });

    $(window).click(function (event) {
      if ($(event.target).is(modal._element)) {
        modal.hide();
      }
    });

    $("#modalForm").submit(function (event) {
      event.preventDefault();

      const username = $("#username").val();
      const notes = $("#notes").val();
      const user_type = "User";
      const companyId = storedCompanyId;
      const userId = $("#userId").val();
      const submitBtn = $("#userModalSubmitBtn");

      setSubmitLoading(submitBtn, true);

      $.ajax({
        type: "POST",
        url: `/companies/${companyId}/users`,
        data: {
          userId: userId,
          company_id: companyId,
          username: username,
          user_type: user_type,
          notes: notes,
        },
        success: function () {
          fetchUsersTable();
          modal.hide();
          $("#modalForm")[0].reset();
          $("#userId").val("");

          const usernameField = $("#username").closest(".col-md-6");
          usernameField.show();
          $("#username").attr("required", true);
          $("#userModalTitle").text("Add Account");
        },
        error: function () {
          alert("Error submitting the user. Please try again.");
        },
        complete: function () {
          setSubmitLoading(submitBtn, false);
        },
      });
    });

    $("#subAccountmodalForm").submit(function (event) {
      event.preventDefault();
      const submitBtn = $("#subAccountSubmitBtn");

      setSubmitLoading(submitBtn, true);

      $.ajax({
        type: "POST",
        url: `/companies/${storedCompanyId}/sub_accounts`,
        data: {
          company_id: storedCompanyId,
          account_username: $("#account_username").val(),
          user_id: $("#user_id").val(),
          account_type_id: $("#account_type_id").val(),
          notes: $("#sub_notes").val(),
        },
        success: function () {
          fetchUsersTable();
          subAccountModal.hide();
          $("#subAccountmodalForm")[0].reset();
        },
        error: function () {
          alert("Error submitting the sub-account. Please try again.");
        },
        complete: function () {
          setSubmitLoading(submitBtn, false);
        },
      });
    });

    fetchUsersTable();
    fetchAccounttype();
    fetchParentAccount();
  });
</script>
