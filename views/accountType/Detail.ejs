<%- contentFor('HeaderCss') %>
<%- include ('../partials/title-meta', {"title":"Account Type Detail"}) %>
<link href="/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/libs/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/css/accounts-page.css" rel="stylesheet" type="text/css" />
<link href="/assets/css/account-type-detail-page.css" rel="stylesheet" type="text/css" />

<%- contentFor('body') %>

<% const typeName = accountType?.name || 'Account Type'; %>
<% const typeInitial = typeName.charAt(0).toUpperCase(); %>
<% let totalTake = 0; let totalGive = 0; %>
<% sub_accounts.forEach(function(account) {
  const bal = parseFloat(account.balance === null ? 0 : String(account.balance).replace(/,/g, ''));
  if (bal < 0) totalTake += bal;
  else totalGive += bal;
}); %>
<% const subCount = sub_accounts.length; %>

<div class="accounts-page account-type-detail-page">
  <div class="accounts-page-header">
    <div>
      <p class="accounts-page-eyebrow">Configuration</p>
      <h1 class="accounts-page-title">Account Type Detail</h1>
      <p class="accounts-page-desc">Take and give balances for sub-accounts on this platform</p>
    </div>
  </div>

  <div class="account-detail-hero">
    <span class="account-detail-avatar"><%= typeInitial %></span>
    <div>
      <h2 class="account-detail-name"><%= typeName %></h2>
      <p class="account-detail-meta"><%= subCount %> sub-account<%= subCount === 1 ? '' : 's' %> linked to this type</p>
    </div>
  </div>

  <div class="accounts-stats-row">
    <div class="accounts-stat-card">
      <div class="stat-icon count">
        <i class="mdi mdi-account-multiple-outline"></i>
      </div>
      <div>
        <span class="stat-value"><%= subCount %></span>
        <span class="stat-label">Sub Accounts</span>
      </div>
    </div>
    <div class="accounts-stat-card">
      <div class="stat-icon take">
        <i class="mdi mdi-arrow-down-bold-circle-outline"></i>
      </div>
      <div>
        <span class="stat-value"><%= Math.round(totalTake).toLocaleString() %></span>
        <span class="stat-label">Total Take</span>
      </div>
    </div>
    <div class="accounts-stat-card">
      <div class="stat-icon give">
        <i class="mdi mdi-arrow-up-bold-circle-outline"></i>
      </div>
      <div>
        <span class="stat-value"><%= Math.round(totalGive).toLocaleString() %></span>
        <span class="stat-label">Total Give</span>
      </div>
    </div>
  </div>

  <div class="accounts-table-card">
    <div class="accounts-table-card-header">
      <div>
        <h5><i class="mdi mdi-swap-vertical"></i> Take & Give Summary</h5>
        <p>Negative balances appear in Take, positive in Give</p>
      </div>
      <span class="account-detail-count-badge"><%= subCount %> rows</span>
    </div>
    <div class="accounts-table-body">
      <table id="subdatatable" class="table atd-table dt-responsive nowrap w-100 mb-0">
        <thead>
          <tr>
            <th>Username</th>
            <th>Take</th>
            <th>Give</th>
            <th>Updated At</th>
          </tr>
        </thead>
        <tbody>
          <% sub_accounts.forEach(function(account) { %>
          <% const balance = parseFloat(account.balance === null ? 0 : String(account.balance).replace(/,/g, '')); %>
          <% const rounded = Math.round(balance); %>
          <% const initial = (account.account_username || '?').charAt(0).toUpperCase(); %>
          <tr>
            <td>
              <div class="acct-title-cell">
                <span class="acct-avatar"><%= initial %></span>
                <span class="acct-title-text"><%= account.account_username %></span>
              </div>
            </td>
            <td class="atd-col-take">
              <% if (balance < 0) { %>
              <span class="atd-take-badge"><%= rounded.toLocaleString() %></span>
              <% } else { %>
              <span class="atd-empty">—</span>
              <% } %>
            </td>
            <td class="atd-col-give">
              <% if (balance >= 0) { %>
              <span class="atd-give-badge"><%= rounded.toLocaleString() %></span>
              <% } else { %>
              <span class="atd-empty">—</span>
              <% } %>
            </td>
            <td>
              <% if (account.updatedAt) { %>
              <% const updatedAt = new Date(account.updatedAt); %>
              <span class="atd-date-badge" data-order="<%= updatedAt.getTime() %>">
                <i class="mdi mdi-calendar-clock"></i>
                <%= formatRelativeDate(account.updatedAt) %>
              </span>
              <% } else { %>
              <span class="atd-empty">—</span>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr>
            <th>Total</th>
            <th><span class="atd-total-value take"><%= Math.round(totalTake).toLocaleString() %></span></th>
            <th><span class="atd-total-value give"><%= Math.round(totalGive).toLocaleString() %></span></th>
            <th></th>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
</div>

<%- contentFor('FooterJs') %>
<script src="/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="/assets/libs/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
<script src="/assets/libs/datatables.net-responsive-bs4/js/responsive.bootstrap4.min.js"></script>

<script>
  $(document).ready(function () {
    $("#subdatatable").DataTable({
      order: [],
      pageLength: 600,
      lengthMenu: [[600, 300, 100, -1], [600, 300, 100, "All"]],
      paging: true,
      searching: true,
      autoWidth: false,
    });

    const storedCompanyId = localStorage.getItem("company_id");
    if (storedCompanyId) {
      showSidebarLinks(storedCompanyId);
    }
  });
</script>
