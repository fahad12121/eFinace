<%- contentFor('HeaderCss') %>
<%- include ('../partials/title-meta', {"title":"Account Types"}) %>
<link href="/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/libs/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/css/accounts-page.css" rel="stylesheet" type="text/css" />
<link href="/assets/css/account-types-page.css" rel="stylesheet" type="text/css" />

<%- contentFor('body') %>

<div class="accounts-page account-types-page">
  <div class="accounts-page-header">
    <div>
      <p class="accounts-page-eyebrow">Configuration</p>
      <h1 class="accounts-page-title">Account Types Table</h1>
      <p class="accounts-page-desc">Manage website and platform types for sub-accounts</p>
    </div>
    <div class="accounts-header-actions">
      <button class="accounts-header-btn accounts-header-btn-primary" id="openModal">
        <i class="mdi mdi-plus"></i>
        Add Account Type
      </button>
    </div>
  </div>

  <div class="accounts-stats-row">
    <div class="accounts-stat-card">
      <div class="stat-icon count">
        <i class="mdi mdi-web"></i>
      </div>
      <div>
        <span class="stat-value" id="totalAccountTypesCount">0</span>
        <span class="stat-label">Total Account Types</span>
      </div>
    </div>
  </div>

  <div class="accounts-table-card">
    <div class="accounts-table-card-header">
      <div>
        <h5><i class="mdi mdi-format-list-bulleted"></i> All Account Types</h5>
        <p>Browse types and open details for linked sub-accounts</p>
      </div>
    </div>
    <div class="accounts-table-body">
      <table id="accounttypetable" class="table account-types-table dt-responsive nowrap w-100 mb-0">
        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Status</th>
            <th>Updated At</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </div>
</div>

<div class="modal fade accounts-modal" id="AccountTypeModal" tabindex="-1" aria-labelledby="accountTypeModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <div class="modal-title-icon">
            <i class="mdi mdi-web-plus"></i>
          </div>
          <div>
            <h5 class="modal-title" id="accountTypeModalLabel">New Account Type</h5>
            <p class="modal-subtitle">Add a website or platform type</p>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="modalForm">
          <div class="mb-0">
            <label for="name" class="form-label">Name</label>
            <input type="text" class="form-control" id="name" placeholder="e.g. playfair, ff.live" required autocomplete="off" />
            <p class="accounts-modal-field-error" id="accountTypeNameError" aria-live="polite"></p>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-cancel" id="closeModalButton" data-bs-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-submit" id="accountTypeSubmitBtn" form="modalForm">Submit</button>
      </div>
    </div>
  </div>
</div>

<%- contentFor('FooterJs') %>
<script src="/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="/assets/libs/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
<script src="/assets/libs/datatables.net-responsive-bs4/js/responsive.bootstrap4.min.js"></script>
<script src="/assets/js/format-relative-date.js"></script>

<script>
  $(document).ready(function () {
    const storedCompanyId = localStorage.getItem("company_id");

    const dataTable = $("#accounttypetable").DataTable({
      order: [[0, "asc"]],
      pageLength: 120,
      lengthMenu: [[120, 50, 100, -1], [120, 50, 100, "All"]],
      paging: true,
      searching: true,
      autoWidth: false,
    });

    function formatStatus(status) {
      const isActive = parseInt(status, 10) === 0;
      const cls = isActive ? "active" : "inactive";
      const label = isActive ? "Active" : "Inactive";
      const icon = isActive ? "mdi-check-circle-outline" : "mdi-minus-circle-outline";
      return `<span class="at-status-badge ${cls}"><i class="mdi ${icon}"></i>${label}</span>`;
    }

    function formatName(name) {
      const initial = (name || "?").charAt(0).toUpperCase();
      return `<div class="at-name-cell"><span class="at-avatar">${initial}</span><span class="at-name-text">${name || "—"}</span></div>`;
    }

    function formatDate(value) {
      if (!value) return '<span class="at-date-empty">—</span>';
      const date = new Date(value);
      if (isNaN(date.getTime())) return `<span class="at-date-badge">${value}</span>`;
      const formatted = formatRelativeDate(value);
      return `<span class="at-date-badge" data-order="${date.getTime()}"><i class="mdi mdi-calendar-clock"></i>${formatted}</span>`;
    }

    let allAccountTypes = [];

    function setSubmitLoading($btn, loading) {
      if (loading) {
        $btn.prop("disabled", true).html('<i class="mdi mdi-loading mdi-spin"></i><span>Submitting...</span>');
      } else {
        $btn.prop("disabled", false).html("Submit");
      }
    }

    function clearAccountTypeNameError() {
      $("#name").removeClass("is-invalid");
      $("#accountTypeNameError").removeClass("is-visible").text("");
    }

    function showAccountTypeNameError(message) {
      $("#name").addClass("is-invalid").trigger("focus");
      $("#accountTypeNameError").addClass("is-visible").text(message);
    }

    function accountTypeNameExists(name) {
      const normalized = String(name || "").trim().toLowerCase();
      if (!normalized) return false;
      return allAccountTypes.some(function (account) {
        return String(account.name || "").trim().toLowerCase() === normalized;
      });
    }

    function fetchAccounttype() {
      $.ajax({
        type: "GET",
        url: `/companies/${storedCompanyId}/account_types/ajax`,
        success: function (response) {
          dataTable.clear();
          allAccountTypes = response.accountTypes || [];

          allAccountTypes.forEach(function (account) {
            dataTable.row.add([
              `<span class="at-id-badge">${account.id}</span>`,
              formatName(account.name),
              formatStatus(account.status),
              formatDate(account.updatedAt),
              `<a href="javascript:void(0);" class="at-view-btn accountbtn" data-id="${account.id}" title="View details"><i class="mdi mdi-eye-outline"></i></a>`,
            ]);
          });

          $("#totalAccountTypesCount").text(allAccountTypes.length);
          dataTable.draw();
        },
        error: function (error) {
          console.log(error);
        },
      });
    }

    $(document).on("click", ".accountbtn", function () {
      window.location.href = `/companies/${storedCompanyId}/account_types/${$(this).data("id")}`;
    });

    const modal = new bootstrap.Modal(document.getElementById("AccountTypeModal"), { keyboard: false });

    $("#openModal").click(function () {
      clearAccountTypeNameError();
      $("#modalForm")[0].reset();
      modal.show();
    });

    $("#closeModalButton").click(function () {
      modal.hide();
    });

    $("#name").on("input", function () {
      clearAccountTypeNameError();
    });

    $(window).click(function (event) {
      if ($(event.target).is(modal._element)) modal.hide();
    });

    $("#modalForm").submit(function (event) {
      event.preventDefault();
      clearAccountTypeNameError();

      const nameValue = $("#name").val();
      if (accountTypeNameExists(nameValue)) {
        showAccountTypeNameError("This account type already exists");
        return;
      }

      const submitBtn = $("#accountTypeSubmitBtn");
      setSubmitLoading(submitBtn, true);

      const companyId = window.location.pathname.split("/")[2];

      $.ajax({
        type: "POST",
        url: `/companies/${companyId}/account_types`,
        data: { name: nameValue, company_id: companyId },
        success: function () {
          fetchAccounttype();
          modal.hide();
          $("#modalForm")[0].reset();
          clearAccountTypeNameError();
        },
        error: function (xhr) {
          const message =
            (xhr.responseJSON && xhr.responseJSON.message) ||
            "Error submitting the account type. Please try again.";

          if (xhr.status === 409 || xhr.status === 400) {
            showAccountTypeNameError(message);
            return;
          }

          showAccountTypeNameError(message);
        },
        complete: function () {
          setSubmitLoading(submitBtn, false);
        },
      });
    });

    if (storedCompanyId) {
      showSidebarLinks(storedCompanyId);
    }

    fetchAccounttype();
  });
</script>
