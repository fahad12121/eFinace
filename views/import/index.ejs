<%- contentFor('HeaderCss') %>
<%- include ('../partials/title-meta', {"title":"Import"}) %>
<link href="/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/libs/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/libs/select2/css/select2.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/css/accounts-page.css" rel="stylesheet" type="text/css" />
<link href="/assets/css/import-page.css" rel="stylesheet" type="text/css" />

<%- contentFor('body') %>

<div class="accounts-page import-page">
  <div class="accounts-page-header">
    <div>
      <p class="accounts-page-eyebrow">Data Management</p>
      <h1 class="accounts-page-title">Import</h1>
      <p class="accounts-page-desc">Upload a spreadsheet to validate and import account balances</p>
    </div>
  </div>

  <div class="accounts-stats-row">
    <div class="accounts-stat-card">
      <div class="stat-icon types">
        <i class="mdi mdi-layers-outline"></i>
      </div>
      <div>
        <span class="stat-value"><%= accountTypes.length %></span>
        <span class="stat-label">Account Types</span>
      </div>
    </div>
    <div class="accounts-stat-card">
      <div class="stat-icon rows">
        <i class="mdi mdi-table-row"></i>
      </div>
      <div>
        <span class="stat-value" id="importRowsCount">0</span>
        <span class="stat-label">Rows Validated</span>
      </div>
    </div>
    <div class="accounts-stat-card">
      <div class="stat-icon errors">
        <i class="mdi mdi-alert-circle-outline"></i>
      </div>
      <div>
        <span class="stat-value" id="importErrorsCount">0</span>
        <span class="stat-label">Not Found</span>
      </div>
    </div>
  </div>

  <div class="accounts-table-card">
    <div class="accounts-table-card-header">
      <div>
        <h5><i class="mdi mdi-file-import-outline"></i> Import Form</h5>
        <p>Select an account type, upload your file, then validate before submitting</p>
      </div>
      <span class="import-preview-badge" id="previewBadge">
        <i class="mdi mdi-information-outline"></i>
        Awaiting validation
      </span>
    </div>

    <div class="import-form-bar">
      <div class="import-form-row">
        <div class="import-form-group">
          <label for="account_type">Account Type</label>
          <select class="form-control select2" id="account_type" name="account_type">
            <option value="" selected disabled>--Select--</option>
            <% accountTypes.forEach(function(account) { %>
            <option value="<%= account.id %>"><%= account.name %></option>
            <% }) %>
          </select>
        </div>

        <div class="import-form-group file-group">
          <label for="import_data">File</label>
          <div class="import-file-wrap">
            <input type="file" class="import-file-input" name="import_data" id="import_data" accept=".xlsx,.xls,.csv" />
            <div class="import-file-row">
              <label for="import_data" class="import-file-label">
                <i class="mdi mdi-file-excel-outline"></i>
                <span>Browse file</span>
              </label>
              <span class="import-file-name" id="fileNameDisplay">No file selected</span>
            </div>
          </div>
        </div>

        <div class="import-form-actions">
          <button type="button" class="import-validate-btn" id="validateBtn">
            <i class="mdi mdi-check-decagram-outline"></i>
            Validate
          </button>
          <button type="button" class="import-submit-btn" id="submitBtn">
            <i class="mdi mdi-upload-outline"></i>
            Submit
          </button>
        </div>
      </div>
    </div>

    <div class="accounts-table-body">
      <table id="importTable" class="table import-table dt-responsive nowrap w-100 mb-0">
        <thead>
          <tr>
            <th>Name</th>
            <th>Give</th>
            <th>Take</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </div>
</div>

<%- contentFor('FooterJs') %>
<script src="/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="/assets/libs/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
<script src="/assets/libs/datatables.net-responsive-bs4/js/responsive.bootstrap4.min.js"></script>
<script src="/assets/libs/select2/js/select2.min.js"></script>
<script>
  $(document).ready(function () {
    const validateDefaultHtml = $("#validateBtn").html();
    const submitDefaultHtml = $("#submitBtn").html();
    let importTable = null;

    function getCompanyIdFromUrl() {
      return window.location.pathname.split("/")[2];
    }

    function formatAmount(value, type) {
      if (value === "" || value === null || value === undefined) {
        return '<span class="imp-amount-badge empty">—</span>';
      }
      const num = Number(value);
      const display = isNaN(num) ? value : num.toLocaleString();
      return '<span class="imp-amount-badge ' + type + '">' + display + "</span>";
    }

    function formatNameCell(username, isFound) {
      const initial = (username || "?").charAt(0).toUpperCase();
      const errorBadge = isFound
        ? ""
        : '<span class="imp-error-badge"><i class="mdi mdi-alert-circle-outline"></i> Not found</span>';

      return (
        '<div class="imp-name-cell">' +
          '<span class="imp-avatar">' + initial + "</span>" +
          '<span class="imp-name-text">' + (username || "—") + "</span>" +
          errorBadge +
        "</div>"
      );
    }

    function updateStats(rows) {
      const total = rows.length;
      const errors = rows.filter(function (row) { return row.is_found === false; }).length;
      $("#importRowsCount").text(total);
      $("#importErrorsCount").text(errors);

      if (total === 0) {
        $("#previewBadge").html('<i class="mdi mdi-information-outline"></i> Awaiting validation');
      } else if (errors > 0) {
        $("#previewBadge").html('<i class="mdi mdi-alert-outline"></i> ' + errors + " issue" + (errors === 1 ? "" : "s") + " found");
      } else {
        $("#previewBadge").html('<i class="mdi mdi-check-circle-outline"></i> Ready to import');
      }
    }

    function initImportTable() {
      if ($.fn.DataTable.isDataTable("#importTable")) {
        $("#importTable").DataTable().destroy();
      }

      importTable = $("#importTable").DataTable({
        order: [],
        pageLength: 600,
        lengthMenu: [[600, 200, 100, -1], [600, 200, 100, "All"]],
        paging: true,
        searching: true,
        ordering: true,
        autoWidth: false,
        columnDefs: [
          { targets: [1, 2], className: "text-end" },
        ],
      });
    }

    initImportTable();
    $(".select2").select2();

    $("#import_data").on("change", function () {
      const file = this.files[0];
      const $display = $("#fileNameDisplay");
      if (file) {
        $display.text(file.name).addClass("has-file");
      } else {
        $display.text("No file selected").removeClass("has-file");
      }
    });

    function getFormData() {
      const formData = new FormData();
      const accountType = $("#account_type").val();
      const importData = $("#import_data")[0].files[0];

      if (!accountType || !importData) {
        toastr.error("Please select an account type and upload a file.", "Error");
        return null;
      }

      formData.append("account_type", accountType);
      formData.append("import_data", importData);
      return formData;
    }

    $("#validateBtn").on("click", function () {
      const formData = getFormData();
      if (!formData) return;

      const $btn = $(this);
      $btn.prop("disabled", true).html('<i class="mdi mdi-loading mdi-spin"></i> Validating...');

      $.ajax({
        url: "/companies/" + getCompanyIdFromUrl() + "/read-csv",
        type: "POST",
        data: formData,
        processData: false,
        contentType: false,
        success: function (response) {
          initImportTable();
          importTable.clear();

          response.sheetJson.forEach(function (row) {
            const $rowNode = importTable.row.add([
              formatNameCell(row.username, row.is_found),
              formatAmount(row.give, "give"),
              formatAmount(row.take, "take"),
            ]).node();

            if (row.is_found === false) {
              $($rowNode).addClass("imp-row-error");
            }
          });

          importTable.draw();
          updateStats(response.sheetJson);
        },
        error: function (error) {
          console.log("Validation failed:", error);
          toastr.error("Validation failed. Please try again.", "Error");
        },
        complete: function () {
          $btn.prop("disabled", false).html(validateDefaultHtml);
        },
      });
    });

    $("#submitBtn").on("click", function () {
      const formData = getFormData();
      if (!formData) return;

      const $btn = $(this);
      $btn.prop("disabled", true).html('<i class="mdi mdi-loading mdi-spin"></i> Submitting...');

      $.ajax({
        url: "/companies/" + getCompanyIdFromUrl() + "/store-csv",
        type: "POST",
        data: formData,
        processData: false,
        contentType: false,
        success: function (response) {
          toastr.success(response.message || "Data imported successfully", "Success");
          setTimeout(function () {
            location.reload();
          }, 500);
        },
        error: function (error) {
          console.log("Submission failed:", error);
          toastr.error("Submission failed. Please try again.", "Error");
        },
        complete: function () {
          $btn.prop("disabled", false).html(submitDefaultHtml);
        },
      });
    });

    var storedCompanyId = localStorage.getItem("company_id");
    if (storedCompanyId) {
      showSidebarLinks(storedCompanyId);
    }
  });
</script>
