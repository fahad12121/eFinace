<!-- JAVASCRIPT -->
<script src="/assets/libs/jquery/jquery.min.js"></script>
<script src="/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/assets/libs/metismenu/metisMenu.min.js"></script>
<script src="/assets/libs/simplebar/simplebar.min.js"></script>
<script src="/assets/libs/node-waves/waves.min.js"></script>
<!-- Toast -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
<script>
  // Function to show the sidebar links based on company_id in localStorage
  function showSidebarLinks(companyId) {
    // Get user permissions from localStorage
    const permissions = JSON.parse(localStorage.getItem("permissions"));
    const userType = localStorage.getItem("userType");
    // console.log(userType);
    // If permissions are not available, return and do not show any sidebar links
    // if (!permissions) return;

    // Dashboard link
    if (userType === 'Admin') {
      $("#dashboardLink").removeClass("d-none");
      $("#dashboardLink a").attr(
        "href",
        "/companies/" + companyId + "/dashboard"
      );
    } else {
      $("#dashboardLink").addClass("d-none");
      $("#companiesLink").addClass("d-none");
    }
    // Accounts link
    if ((permissions.accounts && permissions.accounts.view == true) || userType === 'Admin') {
      
      $("#accountsLink").removeClass("d-none");
      $("#accountsLink a").attr(
        "href",
        "/companies/" + companyId + "/accounts"
      );
    } else {
      $("#accountsLink").addClass("d-none");
    }

    // Transactions link
    if ((permissions.transactions && permissions.transactions.view == true) || userType === 'Admin') {
      $("#transactionsLink").removeClass("d-none");
      $("#transactionsLink a").attr(
        "href",
        "/companies/" + companyId + "/transactions"
      );
    } else {
      $("#transactionsLink").addClass("d-none");
    }

    // Account Types link
    if ((permissions.account_types && permissions.account_types.view === true) || userType === 'Admin') {
      $("#accountstypeLink").removeClass("d-none");
      $("#accountstypeLink a").attr(
        "href",
        "/companies/" + companyId + "/account_types"
      );
    } else {
      $("#accountstypeLink").addClass("d-none");
    }

    // Balance Sheet link
    if ((permissions.balance_sheet && permissions.balance_sheet.view === true) || userType === 'Admin') {
      $("#balanceLink").removeClass("d-none");
      $("#balanceLink a").attr(
        "href",
        "/companies/" + companyId + "/balance-sheet"
      );
    } else {
      $("#balanceLink").addClass("d-none");
    }

    // Import link
    if ((permissions.import && permissions.import.add == true) || userType === 'Admin') {
      $("#importLink").removeClass("d-none");
      $("#importLink a").attr("href", "/companies/" + companyId + "/import");
    } else {
      $("#importLink").addClass("d-none");
    }

    // Users link (optional, based on permissions)
    if (userType === 'Admin') {
      $("#usersLink").removeClass("d-none");
      $("#usersLink a").attr("href", "/companies/" + companyId + "/users");
    } else {
      $("#usersLink").addClass("d-none");
    }

    setActiveSidebarMenu();
    return permissions;
  }

  function normalizePath(path) {
    if (!path) return "/";
    return path.replace(/\/+$/, "") || "/";
  }

  function setActiveSidebarMenu() {
    const currentPath = normalizePath(window.location.pathname);

    $("#sidebar-menu a").removeClass("active");
    $("#sidebar-menu li").removeClass("mm-active mm-show");

    let bestMatch = null;
    let bestMatchLength = -1;

    $("#sidebar-menu li:not(.d-none) > a.ef-nav-link").each(function () {
      const href = $(this).attr("href");
      if (!href || href.indexOf(":id") !== -1) return;

      let linkPath;
      try {
        linkPath = normalizePath(new URL(href, window.location.origin).pathname);
      } catch (error) {
        return;
      }

      let isMatch = false;

      if (linkPath === "/companies") {
        isMatch = currentPath === "/companies";
      } else {
        isMatch =
          currentPath === linkPath ||
          currentPath.startsWith(linkPath + "/");
      }

      if (isMatch && linkPath.length > bestMatchLength) {
        bestMatch = this;
        bestMatchLength = linkPath.length;
      }
    });

    if (bestMatch) {
      const $link = $(bestMatch);
      $link.addClass("active");
      $link.parent("li").addClass("mm-active");
    }
  }

  function initSidebarNavigation() {
    const currentPath = normalizePath(window.location.pathname);

    if (currentPath === "/companies") {
      localStorage.removeItem("company_id");
      $("#dashboardLink, #accountsLink, #transactionsLink, #accountstypeLink, #balanceLink, #importLink, #usersLink").addClass("d-none");
      setActiveSidebarMenu();
      return;
    }

    const companyMatch = currentPath.match(/^\/companies\/(\d+)/);
    const companyId = companyMatch ? companyMatch[1] : localStorage.getItem("company_id");

    if (companyId) {
      localStorage.setItem("company_id", companyId);
      showSidebarLinks(companyId);
      return;
    }

    setActiveSidebarMenu();
  }

  $(window).on("load", function () {
    initSidebarNavigation();
  });
</script>
<script>
  // Ensure the script runs after the DOM is fully loaded
  document.addEventListener("DOMContentLoaded", function () {
    const logoutLink = document.getElementById("logoutLink");

    // Check if the logoutLink element exists
    if (logoutLink) {
      logoutLink.addEventListener("click", async function (event) {
        event.preventDefault(); // Prevent the default action (navigation)

        try {
          // Send a logout request to the server
          const response = await fetch("/logout", {
            method: "POST",
            credentials: "same-origin", // Ensure the cookie is sent along with the request
            headers: {
              "Content-Type": "application/json",
            },
          });

          const data = await response.json();

          if (response.ok) {
            // Handle successful logout, such as redirecting the user to the home page or login page
            window.location.href = "/"; // Redirect to login page or home page
          } else {
            // Handle errors, for example show a message if something went wrong
            alert(data.message || "Logout failed!");
          }
        } catch (error) {
          // Handle network or other errors
          console.error("Error logging out:", error);
          alert("Something went wrong while logging out.");
        }
      });
    } else {
      // console.error("Logout link not found in the DOM");
    }
  });
</script>
