<%- contentFor('HeaderCss') %>
<%- include ('../partials/title-meta', {"title":"Balance Sheet"}) %>
<link href="/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/libs/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/css/accounts-page.css" rel="stylesheet" type="text/css" />
<link href="/assets/css/balance-sheet-page.css" rel="stylesheet" type="text/css" />

<%- contentFor('body') %>

<% const netBalance = totalPlus + totalMinus; %>

<div class="accounts-page balance-sheet-page">
  <div class="accounts-page-header">
    <div>
      <p class="accounts-page-eyebrow">Reports</p>
      <h1 class="accounts-page-title">Balance Sheet</h1>
      <p class="accounts-page-desc">Compare minus and plus accounts across your company</p>
    </div>
    <div class="accounts-header-actions">
      <button class="accounts-header-btn accounts-header-btn-fav" id="addfavt">
        <i class="mdi mdi-star-outline"></i>
        Add to Favorites
      </button>
    </div>
  </div>

  <div class="accounts-stats-row">
    <div class="accounts-stat-card">
      <div class="stat-icon minus">
        <i class="mdi mdi-arrow-down-bold-circle-outline"></i>
      </div>
      <div>
        <span class="stat-value"><%= Math.round(totalMinus).toLocaleString() %></span>
        <span class="stat-label">Total Minus</span>
        <span class="stat-hint negative"><%= minusAccounts.length %> accounts</span>
      </div>
    </div>
    <div class="accounts-stat-card">
      <div class="stat-icon plus">
        <i class="mdi mdi-arrow-up-bold-circle-outline"></i>
      </div>
      <div>
        <span class="stat-value"><%= Math.round(totalPlus).toLocaleString() %></span>
        <span class="stat-label">Total Plus</span>
        <span class="stat-hint positive"><%= plusAccounts.length %> accounts</span>
      </div>
    </div>
    <div class="accounts-stat-card">
      <div class="stat-icon net">
        <i class="mdi mdi-scale-balance"></i>
      </div>
      <div>
        <span class="stat-value"><%= Math.round(netBalance).toLocaleString() %></span>
        <span class="stat-label">Net Balance</span>
        <span class="stat-hint <%= netBalance >= 0 ? 'positive' : 'negative' %>">
          Plus + Minus combined
        </span>
      </div>
    </div>
  </div>

  <div class="balance-sheet-grid">
    <div class="balance-sheet-card minus">
      <div class="balance-sheet-card-header">
        <div>
          <h5><i class="mdi mdi-arrow-down-bold-circle-outline"></i> Minus Accounts</h5>
          <p>Accounts with negative balances</p>
        </div>
        <span class="balance-sheet-count-badge minus"><%= minusAccounts.length %> accounts</span>
      </div>
      <div class="balance-sheet-card-body">
        <table id="Minusdatatable" class="table balance-sheet-table minus-table dt-responsive nowrap w-100 mb-0">
          <thead>
            <tr>
              <th>Account</th>
              <th>Minus</th>
            </tr>
          </thead>
          <tbody>
            <% minusAccounts.forEach(function(item) { %>
            <% const amount = parseFloat(String(item.minus).replace(/,/g, '')); %>
            <% const initial = (item.account || '?').charAt(0).toUpperCase(); %>
            <tr>
              <td>
                <div class="bs-account-cell">
                  <input type="checkbox" class="bs-checkbox fav-checkbox" data-id="<%= item.user_id %>" />
                  <a href="/companies/<%= company_id %>/ledger/<%= item.user_id %>" class="bs-account-link">
                    <span class="bs-account-avatar"><%= initial %></span>
                    <span class="bs-account-name"><%= item.account %></span>
                  </a>
                </div>
              </td>
              <td class="bs-col-amount">
                <% if (amount < 0) { %>
                <span class="bs-minus-badge"><%= Math.round(amount).toLocaleString() %></span>
                <% } else { %>
                <span class="bs-plain-amount"><%= Math.round(amount).toLocaleString() %></span>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
          <tfoot>
            <tr>
              <th>Total</th>
              <th class="bs-col-amount"><span class="bs-total-value minus"><%= Math.round(totalMinus).toLocaleString() %></span></th>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>

    <div class="balance-sheet-card plus">
      <div class="balance-sheet-card-header">
        <div>
          <h5><i class="mdi mdi-arrow-up-bold-circle-outline"></i> Plus Accounts</h5>
          <p>Accounts with positive balances</p>
        </div>
        <span class="balance-sheet-count-badge plus"><%= plusAccounts.length %> accounts</span>
      </div>
      <div class="balance-sheet-card-body">
        <table id="Plusdatatable" class="table balance-sheet-table plus-table dt-responsive nowrap w-100 mb-0">
          <thead>
            <tr>
              <th>Account</th>
              <th>Plus</th>
            </tr>
          </thead>
          <tbody>
            <% plusAccounts.forEach(function(item) { %>
            <% const amount = parseFloat(String(item.plus).replace(/,/g, '')); %>
            <% const initial = (item.account || '?').charAt(0).toUpperCase(); %>
            <tr>
              <td>
                <div class="bs-account-cell">
                  <input type="checkbox" class="bs-checkbox fav-checkbox" data-id="<%= item.user_id %>" />
                  <a href="/companies/<%= company_id %>/ledger/<%= item.user_id %>" class="bs-account-link">
                    <span class="bs-account-avatar"><%= initial %></span>
                    <span class="bs-account-name"><%= item.account %></span>
                  </a>
                </div>
              </td>
              <td class="bs-col-amount">
                <% if (amount > 0) { %>
                <span class="bs-plus-badge"><%= Math.round(amount).toLocaleString() %></span>
                <% } else { %>
                <span class="bs-plain-amount"><%= amount %></span>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
          <tfoot>
            <tr>
              <th>Total</th>
              <th class="bs-col-amount"><span class="bs-total-value plus"><%= Math.round(totalPlus).toLocaleString() %></span></th>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </div>
</div>

<%- contentFor('FooterJs') %>
<script src="/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="/assets/libs/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
<script src="/assets/libs/datatables.net-responsive-bs4/js/responsive.bootstrap4.min.js"></script>

<script>
  $(document).ready(function () {
    const tableOptions = {
      pageLength: 300,
      lengthMenu: [[300, 50, 100, -1], [300, 50, 100, "All"]],
      paging: true,
      searching: true,
      autoWidth: false,
      order: [],
    };

    $("#Minusdatatable").DataTable({ ...tableOptions, order: [[1, "asc"]] });
    $("#Plusdatatable").DataTable(tableOptions);

    const storedCompanyId = localStorage.getItem("company_id");

    $("#addfavt").click(function () {
      const selectedAccounts = [];
      $(".fav-checkbox:checked").each(function () {
        selectedAccounts.push($(this).data("id"));
      });

      if (selectedAccounts.length === 0) {
        toastr.error("Please select at least one account to add to favorites", "Error");
        return;
      }

      $.ajax({
        type: "POST",
        url: `/companies/${storedCompanyId}/add_to_favt`,
        data: { accounts: selectedAccounts },
        success: function (response) {
          toastr.success(response.message, "Success");
          setTimeout(function () {
            location.reload();
          }, 1500);
        },
        error: function (error) {
          console.log(error);
          alert("Error adding accounts to favorites. Please try again.");
        },
      });
    });

    if (storedCompanyId) {
      showSidebarLinks(storedCompanyId);
    }
  });
</script>
