<%- contentFor('HeaderCss') %>
<%- include ('../partials/title-meta', {"title": "Dashboard"}) %>
<link href="/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/libs/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/css/dashboard-page.css" rel="stylesheet" type="text/css" />

<%- contentFor('body') %>

<div class="dashboard-page">
  <div class="dashboard-page-header">
    <div>
      <p class="dashboard-page-eyebrow">Overview</p>
      <h1 class="dashboard-page-title">Dashboard</h1>
      <p class="dashboard-page-desc">Your company snapshot at a glance</p>
    </div>
  </div>

  <div class="dashboard-hero-row">
    <div class="dashboard-welcome-card">
      <p class="dashboard-welcome-label">Welcome back</p>
      <h2 class="dashboard-welcome-title">eFinance Dashboard</h2>
      <p class="dashboard-welcome-subtitle">Track balances, favourites, and recent activity</p>
    </div>

    <a href="/companies/<%= companyId %>/balance-sheet" class="dashboard-stat-link">
      <div class="dashboard-stat-card">
        <div class="dashboard-stat-icon balance">
          <i class="mdi mdi-scale-balance"></i>
        </div>
        <div class="dashboard-stat-content">
          <p class="dashboard-stat-label">Balance Sheet</p>
          <p class="dashboard-stat-value dashboard-stat-value-balance">
            <span class="amount-plus"><%= Math.round(sumOfPlus).toLocaleString() %></span>
            <span class="amount-separator">/</span>
            <span class="amount-minus"><%= Math.round(sumOfMinus).toLocaleString() %></span>
          </p>
          <p class="dashboard-stat-hint">Plus / Minus totals</p>
        </div>
      </div>
    </a>

    <a href="/companies/<%= companyId %>/favourite_list" class="dashboard-stat-link">
      <div class="dashboard-stat-card">
        <div class="dashboard-stat-icon favourites">
          <i class="mdi mdi-star-outline"></i>
        </div>
        <div class="dashboard-stat-content">
          <p class="dashboard-stat-label">Favourite Accounts</p>
          <p class="dashboard-stat-value"><%= favtUsersCount %></p>
          <p class="dashboard-stat-hint">Saved accounts you follow</p>
        </div>
      </div>
    </a>
  </div>

  <div class="dashboard-table-card">
    <div class="dashboard-table-card-header">
      <div>
        <h5>Last 2 Days Transactions</h5>
        <p>Recent activity across your accounts</p>
      </div>
    </div>
    <div class="dashboard-table-body">
      <div class="table-responsive">
        <table id="dashboardTransTable" class="table dashboard-transactions-table dt-responsive nowrap w-100 mb-0">
          <thead>
            <tr>
              <th class="tx-col-date">Date</th>
              <th class="tx-col-plus">Plus</th>
              <th class="tx-col-plus">Sub Account</th>
              <th class="tx-col-amount">Amount</th>
              <th class="tx-col-minus">Minus</th>
              <th class="tx-col-minus">Sub Account</th>
              <th class="tx-col-narration">Narration</th>
              <th class="tx-col-notes">Notes</th>
            </tr>
          </thead>
          <tbody>
            <% transactions.forEach(function(transaction) { %>
            <tr>
              <td class="tx-col-date">
                <span class="tx-date-badge">
                  <i class="mdi mdi-calendar-outline"></i>
                  <%= transaction.transaction_date %>
                </span>
              </td>
              <td class="tx-col-plus">
                <span class="tx-user-badge tx-user-plus">
                  <i class="mdi mdi-arrow-up-bold-circle-outline"></i>
                  <%= transaction.sender_user %>
                </span>
              </td>
              <td class="tx-col-plus">
                <span class="tx-sub-badge tx-sub-plus"><%= transaction.sender_sub_account %></span>
              </td>
              <td class="tx-col-amount">
                <span class="tx-amount-badge"><%= transaction.amount || 'N/A' %></span>
              </td>
              <td class="tx-col-minus">
                <span class="tx-user-badge tx-user-minus">
                  <i class="mdi mdi-arrow-down-bold-circle-outline"></i>
                  <%= transaction.receiver_user %>
                </span>
              </td>
              <td class="tx-col-minus">
                <span class="tx-sub-badge tx-sub-minus"><%= transaction.receiver_sub_account %></span>
              </td>
              <td class="tx-col-narration">
                <span class="tx-meta-badge tx-narration-badge" title="<%= transaction.narration %>">
                  <i class="mdi mdi-text-box-outline"></i>
                  <%= transaction.narration || '—' %>
                </span>
              </td>
              <td class="tx-col-notes">
                <span class="tx-meta-badge tx-notes-badge" title="<%= transaction.notes %>">
                  <i class="mdi mdi-note-text-outline"></i>
                  <%= transaction.notes || '—' %>
                </span>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- contentFor('FooterJs') %>
<script src="/assets/js/pages/dashboard.init.js"></script>
<script src="/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="/assets/libs/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
<script src="/assets/libs/datatables.net-responsive-bs4/js/responsive.bootstrap4.min.js"></script>
<script src="/assets/js/pages/datatables.init.js"></script>
<script>
  $(document).ready(function () {
    $("#dashboardTransTable").DataTable({
      order: [0, "desc"],
      pageLength: 40,
      lengthMenu: [
        [30, 40, 50, 70, -1],
        [30, 40, 50, 70, "All"],
      ],
      paging: true,
      searching: true,
      autoWidth: false,
      language: {
        search: "",
        searchPlaceholder: "Search...",
        emptyTable: "No transactions in the last 2 days.",
        lengthMenu: "_MENU_ rows",
        info: "_START_–_END_ of _TOTAL_",
        infoEmpty: "0 rows",
        infoFiltered: " (filtered)",
        paginate: {
          previous: "‹",
          next: "›",
        },
      },
    });

    const storedCompanyId = localStorage.getItem("company_id");
    if (storedCompanyId) {
      showSidebarLinks(storedCompanyId);
    }
  });
</script>
