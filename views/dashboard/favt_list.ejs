<%- contentFor('HeaderCss') %>
<%- include ('../partials/title-meta', {"title":"Favorites List"}) %>
<link href="/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/libs/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/css/favorites-page.css" rel="stylesheet" type="text/css" />

<%- contentFor('body') %>

<div class="favorites-page">
  <div class="favorites-page-header">
    <div>
      <p class="favorites-page-eyebrow">Accounts</p>
      <h1 class="favorites-page-title">Favorites Table</h1>
      <p class="favorites-page-desc">Track your starred accounts at a glance</p>
    </div>
  </div>

  <div class="favorites-stats-row">
    <div class="favorites-stat-card">
      <div class="stat-icon total">
        <i class="mdi mdi-star-outline"></i>
      </div>
      <div>
        <span class="stat-value"><%= favtUsers.length %></span>
        <span class="stat-label">Total Favourites</span>
      </div>
    </div>
    <div class="favorites-stat-card">
      <div class="stat-icon sheet1">
        <i class="mdi mdi-scale-balance"></i>
      </div>
      <div>
        <span class="stat-value"><%= Math.round(totalBalance).toLocaleString() %></span>
        <span class="stat-label">Total Balance</span>
        <span class="stat-hint <%= totalBalance >= 0 ? 'positive' : 'negative' %>">
          Combined across all accounts
        </span>
      </div>
    </div>
  </div>

  <div class="favorites-table-card">
    <div class="favorites-table-card-header">
      <div>
        <h5><i class="mdi mdi-star-outline"></i> Favourite Accounts</h5>
        <p>All starred accounts for this company</p>
      </div>
      <span class="favorites-sheet-badge"><%= favtUsers.length %> accounts</span>
    </div>
    <div class="favorites-table-body">
      <div class="table-responsive">
        <table id="favouritesTable" class="table favorites-table dt-responsive nowrap w-100 mb-0">
          <thead>
            <tr>
              <th>ID</th>
              <th>Title</th>
              <th>Balance</th>
              <th>Notes</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% favtUsers.forEach(function(account) { %>
            <% const balance = Math.round(account.balance); %>
            <% const balanceClass = balance > 0 ? 'positive' : balance < 0 ? 'negative' : 'zero'; %>
            <% const initial = (account.username || '?').charAt(0).toUpperCase(); %>
            <tr>
              <td><span class="fav-id-badge"><%= account.account_pk %></span></td>
              <td>
                <div class="fav-title-cell">
                  <span class="fav-avatar"><%= initial %></span>
                  <span class="fav-title-text"><%= account.username %></span>
                </div>
              </td>
              <td>
                <span class="fav-balance-badge <%= balanceClass %>">
                  <%= balance.toLocaleString() %>
                </span>
              </td>
              <td>
                <% if (account.notes) { %>
                <span class="fav-notes-text" title="<%= account.notes %>">
                  <i class="mdi mdi-note-text-outline"></i>
                  <%= account.notes %>
                </span>
                <% } else { %>
                <span class="fav-notes-empty">—</span>
                <% } %>
              </td>
              <td>
                <a
                  href="/companies/<%= companyId %>/accounts/<%= account.id %>"
                  class="fav-view-btn"
                  title="View account"
                >
                  <i class="mdi mdi-eye-outline"></i>
                </a>
              </td>
            </tr>
            <% }) %>
          </tbody>
          <tfoot>
            <tr>
              <th colspan="2">Total Balance</th>
              <th>
                <span class="fav-total-value"><%= Math.round(totalBalance).toLocaleString() %></span>
              </th>
              <th colspan="2"></th>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </div>
</div>

<%- contentFor('FooterJs') %>
<script src="/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="/assets/libs/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
<script src="/assets/libs/datatables.net-responsive-bs4/js/responsive.bootstrap4.min.js"></script>

<script>
  $(document).ready(function () {
    $("#favouritesTable").DataTable({
      pageLength: 100,
      lengthMenu: [[100, 80, 70, -1], [100, 80, 70, "All"]],
      paging: true,
      searching: true,
      autoWidth: false,
      order: [],
    });

    const storedCompanyId = localStorage.getItem("company_id");
    if (storedCompanyId) {
      showSidebarLinks(storedCompanyId);
    }
  });
</script>
